@page "/commits"
@using NexusLabs.Narnia.Core.Models
@using NexusLabs.Narnia.Core.Repositories
@inject ISessionRepository Repository

<PageTitle>Commits — Narnia</PageTitle>

<h1>Commit Traceability</h1>
<p>Find which sessions produced or mentioned a specific commit SHA.</p>

<form method="get" action="/commits" class="commit-search-form">
    <input type="text" name="sha" value="@Sha" placeholder="Enter commit SHA, e.g. abc123f" maxlength="40" />
    <button type="submit">Look up</button>
</form>

@if (!string.IsNullOrWhiteSpace(Sha) && _query is null)
{
    <p class="commit-search-invalid">
        "@Sha" isn't a valid commit SHA — enter @CommitShaQuery.MinLength–@CommitShaQuery.MaxLength hexadecimal characters (0-9, a-f).
    </p>
}
else if (_query is not null && _matches is null)
{
    <p>Searching…</p>
}
else if (_matches is { Length: 0 })
{
    <p>No sessions found for commit <code>@Sha</code>.</p>
}
else if (_matches is not null)
{
    <p><strong>@_matches.Length session(s)</strong> linked to commit <code>@Sha</code></p>
    <table class="sessions-table" data-resizable-table="commit-sessions">
        <thead>
            <tr>
                <th class="col-favorite">Favorite</th>
                <th>Match</th>
                <th>Name</th>
                <th>Remote Repository</th>
                <th>Branch</th>
                <th>Turns</th>
                <th>Updated</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in _matches)
            {
                var s = m.Session;
                <tr>
                    <td class="col-favorite"><FavoriteButton SessionId="@s.Id" IsFavorite="@s.IsFavorite" /></td>
                    <td>
                        @if (m.Confidence == CommitMatchConfidence.Confirmed)
                        {
                            <span class="badge-health badge-ok" title="The CLI explicitly recorded this value as a ref for this session.">confirmed</span>
                        }
                        else
                        {
                            <span class="badge-health badge-neutral" title="This value appears in the session's text but wasn't explicitly recorded as a ref.">mentioned</span>
                        }
                    </td>
                    <td><a href="/sessions/@s.Id">@(s.Summary ?? "(unnamed session)")</a></td>
                    <td><SessionFilterLink FilterName="repository" Value="@s.Repository" /></td>
                    <td>@(s.Branch ?? "—")</td>
                    <td>@s.TurnCount</td>
                    <td>@s.UpdatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [SupplyParameterFromQuery(Name = "sha")]
    public string? Sha { get; set; }

    private CommitShaQuery? _query;
    private CommitMatch[]? _matches;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Sha))
            return;

        _query = CommitShaQuery.TryParse(Sha);
        if (_query is not null)
            _matches = await Repository.GetSessionsByRefAsync(_query.Value);
    }
}

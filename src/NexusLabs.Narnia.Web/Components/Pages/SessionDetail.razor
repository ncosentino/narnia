@page "/sessions/{SessionId}"
@using NexusLabs.Narnia.Core.Models
@using NexusLabs.Narnia.Core.Repositories
@using System.Text.Json
@inject ISessionRepository Repository
@inject IWorkspaceReader WorkspaceReader

<PageTitle>@(_session?.Summary ?? SessionId) — Narnia</PageTitle>

@if (_session is null && _loaded)
{
    <h1>Session not found</h1>
    <p>No session with ID <code>@SessionId</code> was found.</p>
    <a href="/sessions">← Back to sessions</a>
}
else if (_session is not null)
{
    <a href="/sessions">← Sessions</a>
    <h1>@(_session.Summary ?? "(no summary)")</h1>

    <dl class="session-meta">
        <dt>ID</dt><dd><code>@_session.Id</code></dd>
        @if (_session.Repository is not null)
        {
            <dt>Repository</dt><dd>@_session.Repository (@(_session.Branch ?? "unknown branch"))</dd>
        }
        @if (_session.Cwd is not null)
        {
            <dt>Directory</dt><dd><code>@_session.Cwd</code></dd>
        }
        @if (_workspace?.GitRoot is not null)
        {
            <dt>Git Root</dt><dd><code>@_workspace.GitRoot</code></dd>
        }
        <dt>Created</dt><dd>@_session.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")</dd>
        <dt>Updated</dt><dd>@_session.UpdatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")</dd>
        <dt>Turns</dt><dd>@_session.TurnCount</dd>
        <dt>Checkpoints</dt><dd>@_session.CheckpointCount</dd>
    </dl>

    @if (_checkpoints is not null && _checkpoints.Length > 0)
    {
        <h2>Checkpoints</h2>

        @if (_checkpoints.Length > 1)
        {
            <div class="chart-container" style="max-height:200px">
                <canvas id="cp-cadence-chart"></canvas>
            </div>
            <script type="application/json" data-chart-id="cp-cadence-chart">
                @((MarkupString)BuildCadenceChartJson(_checkpoints))
            </script>
        }

        <div class="cp-timeline">
            @foreach (var cp in _checkpoints)
            {
                <div class="cp-timeline-entry">
                    <div class="cp-timeline-header">
                        <span class="cp-timeline-num">#@cp.CheckpointNumber</span>
                        @if (cp.Title is not null)
                        {
                            <span class="cp-timeline-title">@cp.Title</span>
                        }
                        <span class="cp-timeline-date">@cp.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</span>
                    </div>
                    @if (cp.Overview is not null)
                    {
                        <details class="cp-section" open>
                            <summary>Overview</summary>
                            <div class="cp-section-body"><p>@cp.Overview</p></div>
                        </details>
                    }
                    @if (cp.WorkDone is not null)
                    {
                        <details class="cp-section">
                            <summary>Work Done</summary>
                            <div class="cp-section-body"><pre>@cp.WorkDone</pre></div>
                        </details>
                    }
                    @if (cp.NextSteps is not null)
                    {
                        <details class="cp-section">
                            <summary>Next Steps</summary>
                            <div class="cp-section-body"><pre>@cp.NextSteps</pre></div>
                        </details>
                    }
                    @if (cp.ImportantFiles is not null)
                    {
                        <details class="cp-section">
                            <summary>Important Files</summary>
                            <div class="cp-section-body"><pre>@cp.ImportantFiles</pre></div>
                        </details>
                    }
                    @if (cp.History is not null)
                    {
                        <details class="cp-section">
                            <summary>History</summary>
                            <div class="cp-section-body"><pre>@cp.History</pre></div>
                        </details>
                    }
                </div>
            }
        </div>
    }

    @if (_workspace?.ArtifactFiles is { Length: > 0 } files)
    {
        <h2>Session Files</h2>
        <ul>
            @foreach (var f in files)
            {
                <li><code>@f</code></li>
            }
        </ul>
    }

    @if (_turns is not null && _turns.Length > 0)
    {
        <h2>Conversation (@_turns.Length turn@(_turns.Length == 1 ? "" : "s"))</h2>
        @foreach (var turn in _turns)
        {
            <div class="turn">
                <div class="turn-user">
                    <strong>You</strong>
                    <p>@turn.UserMessage</p>
                </div>
                @if (turn.AssistantResponse is not null)
                {
                    <div class="turn-assistant">
                        <strong>Copilot</strong>
                        <p>@turn.AssistantResponse</p>
                    </div>
                }
            </div>
        }
    }
}

@code {
    [Parameter]
    public string SessionId { get; set; } = "";

    private Session? _session;
    private WorkspaceInfo? _workspace;
    private Checkpoint[]? _checkpoints;
    private Turn[]? _turns;
    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        _session = await Repository.GetByIdAsync(SessionId);
        if (_session is not null)
        {
            _workspace = WorkspaceReader.ReadWorkspace(SessionId);
            _checkpoints = await Repository.GetCheckpointsAsync(SessionId);
            _turns = await Repository.GetTurnsAsync(SessionId, 0, 100);
        }
        _loaded = true;
    }

    private static string BuildCadenceChartJson(Checkpoint[] checkpoints) =>
        JsonSerializer.Serialize(new
        {
            type = "line",
            data = new
            {
                labels = checkpoints.Select(c => c.CreatedAt.LocalDateTime.ToString("HH:mm")).ToArray(),
                datasets = new[]
                {
                    new { label = "Checkpoint", data = checkpoints.Select(c => c.CheckpointNumber).ToArray(),
                          borderColor = "rgba(99,102,241,1)", backgroundColor = "rgba(99,102,241,0.1)",
                          pointBackgroundColor = "rgba(99,102,241,1)", tension = 0.3, fill = true }
                }
            },
            options = new
            {
                responsive = true,
                plugins = new { legend = new { display = false } },
                scales = new { y = new { beginAtZero = false, ticks = new { stepSize = 1 } } }
            }
        });
}

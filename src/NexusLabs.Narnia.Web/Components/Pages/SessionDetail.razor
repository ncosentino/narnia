@page "/sessions/{SessionId}"
@using NexusLabs.Narnia.Core.Models
@using NexusLabs.Narnia.Core.Repositories
@using NexusLabs.Narnia.Core.Services
@using System.Text.Json
@inject ISessionRepository Repository
@inject SqliteSessionRepository RawRepository
@inject ISessionOverridesRepository OverridesRepository
@inject IWorkCollectionsRepository CollectionsRepository
@inject IWorkspaceReader WorkspaceReader
@inject INarniaSettingsRepository SettingsRepo
@inject ISessionStorageRepository StorageRepository
@inject ISessionResumeSafetyReader ResumeSafetyReader
@inject ISessionMigrationService MigrationService
@inject ICopilotSidebarTabsService SidebarTabs

<PageTitle>@(_session?.Summary ?? SessionId) — Narnia</PageTitle>

@if (_session is null && _loaded)
{
    <h1>Session not found</h1>
    <p>No session with ID <code>@SessionId</code> was found.</p>
    <a href="/sessions">← Back to sessions</a>
}
else if (_session is not null)
{
    <a href="/sessions">← Sessions</a>
    <h1>
        @(_session.Summary ?? "(unnamed session)")
        @if (HasNarniaAlias)
        {
            <span class="badge-name-source">Narnia alias</span>
        }
    </h1>

    <div class="archive-action">
        <FavoriteButton SessionId="@_session.Id" IsFavorite="@_session.IsFavorite" ShowLabel="true" />
        <button class="btn-archive @(_override?.IsArchived == true ? "btn-archive--active" : "")"
                onclick="narniaToggleArchive('@_session.Id', @(_override?.IsArchived == true ? "false" : "true"))">
            @(_override?.IsArchived == true ? "📤 Unarchive" : "📦 Archive")
        </button>
    </div>

    @if (_relatedMigration is not null)
    {
        <div class="session-migration-link">
            @if (_relatedMigration.Status is SessionMigrationStatus.SessionCreated or SessionMigrationStatus.Completed)
            {
                @if (IsInPlaceMigration)
                {
                    <strong>Recovered in place</strong>
                    <span>
                        Copilot retained this session ID and folder. The original broken event
                        stream remains archived beside the new valid stream.
                    </span>
                }
                else if (IsMigrationSource)
                {
                    <strong>Recovered successor</strong>
                    <span>
                        This session is preserved as the recovery source.
                        <a href="/sessions/@_relatedMigration.ReplacementSessionId">
                            Open successor @ShortSession(_relatedMigration.ReplacementSessionId)
                        </a>
                    </span>
                }
                else
                {
                    <strong>Recovered session</strong>
                    <span>
                        Created from
                        <a href="/sessions/@_relatedMigration.SourceSessionId">
                            source @ShortSession(_relatedMigration.SourceSessionId)
                        </a>
                        without modifying the original history.
                    </span>
                }
            }
            else
            {
                <strong>Recovery attempt @FormatMigrationStatus(_relatedMigration.Status)</strong>
                <span>
                    No usable successor has been confirmed.
                    @if (!string.IsNullOrWhiteSpace(_relatedMigration.Error))
                    {
                        <span>@_relatedMigration.Error</span>
                    }
                </span>
            }
            @if (_relatedMigration.RecoveryPacketBytes > 0)
            {
                <a href="/api/session-migrations/@SessionId/packet">Download recovery packet</a>
            }
        </div>
    }

    @if (_resumeAssessment?.Safety == SessionResumeSafety.Incompatible)
    {
        <section class="session-recovery session-recovery--blocked">
            <div>
                <span class="session-recovery-kicker">Resume blocked for safety</span>
                <h2>This session cannot be resumed as-is</h2>
                <p>@_resumeAssessment.Reason</p>
                <p>
                    Copilot would reject this history and open an unrelated blank session.
                    Narnia has disabled Launch for this session instead of pretending it resumed.
                </p>
            </div>
            @RecoveryPlan
        </section>
    }
    else if (!IsMigrationReplacement)
    {
        <details class="session-recovery">
            <summary>Recover into a new successor session</summary>
            @RecoveryPlan
        </details>
    }

    @if (_sidebar is not null)
    {
        <details class="session-recovery sidebar-tabs">
            <summary>
                Copilot sidebar tabs for this folder
                <span class="sidebar-tabs-count">@_sidebar.TabCount</span>
            </summary>
            <div class="session-recovery-plan">
                <p>
                    Copilot restores these @_sidebar.TabCount session@(_sidebar.TabCount == 1 ? "" : "s")
                    as sidebar tabs whenever <code>@_sidebar.Cwd</code> is opened, and it renders a
                    preview for each one. A long or damaged tab list is a known cause of broken
                    sidebar rendering, and it survives <code>/restart</code> because Copilot reloads
                    the list from disk.
                </p>
                @if (_sidebar.ParseError is not null)
                {
                    <p class="session-recovery-error">@_sidebar.ParseError</p>
                }
                else
                {
                    <ol class="sidebar-tab-list">
                        @foreach (var tab in _sidebar.Tabs)
                        {
                            var isCurrent = string.Equals(
                                tab.SessionId, SessionId, StringComparison.OrdinalIgnoreCase);
                            <li class="@(isCurrent ? "sidebar-tab sidebar-tab--current" : "sidebar-tab")">
                                <a href="/sessions/@tab.SessionId">@(tab.Title ?? "(unnamed session)")</a>
                                @if (isCurrent)
                                {
                                    <span class="badge-name-source">this session</span>
                                }
                                @if (tab.IsLive)
                                {
                                    <span class="badge-name-source">live</span>
                                }
                                @if (!tab.IsKnown)
                                {
                                    <span class="badge-name-source">not in session store</span>
                                }
                                @if (tab.EventStreamBytes is > 0)
                                {
                                    <span class="sidebar-tab-size">@FormatBytes(tab.EventStreamBytes.Value)</span>
                                }
                            </li>
                        }
                    </ol>

                    @if (_sidebar.HasLiveRuntime)
                    {
                        <p class="session-recovery-error">
                            Copilot is running @_sidebar.LiveTabCount of these session@(_sidebar.LiveTabCount == 1 ? "" : "s")
                            and rewrites this list when it exits, so a repair will not stick until
                            those sessions are closed.
                        </p>
                    }

                    <div class="sidebar-tab-actions">
                        @if (SidebarTabForThisSession is not null)
                        {
                            <button class="launch-btn"
                                    data-sidebar-cwd="@_sidebar.Cwd"
                                    data-sidebar-session="@SessionId"
                                    onclick="narniaRepairSidebar(this)">
                                Remove this session from the sidebar
                            </button>
                        }
                        <button class="btn-archive"
                                data-sidebar-cwd="@_sidebar.Cwd"
                                onclick="narniaRepairSidebar(this)">
                            Clear all sidebar tabs for this folder
                        </button>
                    </div>
                    <p class="sidebar-tab-note">
                        Narnia copies the current list beside itself before changing anything.
                        Clearing tabs never deletes a session.
                    </p>
                }
            </div>
        </details>
    }

    @if (_resumeAssessment?.Safety != SessionResumeSafety.Incompatible)
    {
        <div class="resume-commands">
            @foreach (var (label, cmd, target, idx) in BuildResumeEntries())
            {
                <div class="resume-entry">
                    <span class="resume-label">@label</span>
                    <code id="resume-cmd-@idx">@cmd</code>
                    <button class="copy-btn" onclick="narniaCopyText('resume-cmd-@idx', this)" title="Copy to clipboard">📋 Copy</button>
                    @if (target != "none")
                    {
                        <button class="launch-btn" onclick="narniaLaunch('@target', '@_session.Id', this)" title="Launch in terminal">🚀 Launch</button>
                    }
                </div>
            }
        </div>
    }

    <dl class="session-meta">
        <dt>ID</dt><dd><code>@_session.Id</code></dd>
        <dt>Copilot Name</dt>
        <dd>
            @(CopilotName ?? "(unnamed session)")
            @if (HasCopilotNameProvenance)
            {
                <span class="badge-name-source @(_workspace!.IsUserNamed ? "badge-name-source--user" : "")">
                    @(_workspace.IsUserNamed ? "named by you" : "generated by Copilot")
                </span>
            }
        </dd>
        @if (HasNarniaAlias)
        {
            <dt>Narnia Alias</dt><dd>@_override!.DisplayName</dd>
        }
        @if (_session.Repository is not null)
        {
            <dt>Remote Repository</dt>
            <dd><SessionFilterLink FilterName="repository" Value="@_session.Repository" /> (@(_session.Branch ?? "unknown branch"))</dd>
        }
        @if (_session.Cwd is not null)
        {
            <dt>Working Directory</dt>
            <dd><SessionFilterLink FilterName="cwd" Value="@_session.Cwd" CssClass="cwd" /></dd>
        }
        @if (_workspace?.GitRoot is not null)
        {
            <dt>Git Root</dt><dd><code>@_workspace.GitRoot</code></dd>
        }
        <dt>Created</dt><dd>@_session.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")</dd>
        <dt>Updated</dt><dd>@_session.UpdatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")</dd>
        <dt>Live Processes</dt>
        <dd><a href="/processes?q=@Uri.EscapeDataString(_session.Id)">Locate runtime, terminal, and child PIDs</a></dd>
        <dt>Local Storage</dt>
        <dd>
            @if (_storage is null)
            {
                <a href="/storage?q=@Uri.EscapeDataString(_session.Id)">Not measured</a>
            }
            else
            {
                <a href="/storage?q=@Uri.EscapeDataString(_session.Id)">@FormatBytes(_storage.TotalBytes)</a>
                <span>
                    · @_storage.FileCount.ToString("N0") files
                    · @FormatBytes(_storage.EventsBytes) events
                    · @FormatBytes(_storage.ArtifactsBytes) artifacts
                </span>
                @if (!_storage.IsComplete)
                {
                    <span class="storage-danger"> · incomplete scan</span>
                }
            }
        </dd>
        <dt>Turns</dt><dd>@_session.TurnCount</dd>
        <dt>Checkpoints</dt><dd>@_session.CheckpointCount</dd>
        <dt>Collections</dt>
        <dd class="collection-memberships" id="session-collections">
            @foreach (var collection in _collections)
            {
                <a class="collection-chip" href="/collections/@collection.Id">@collection.Name</a>
            }
            @if (_collections.Count == 0)
            {
                <span>None</span>
            }
            <button class="btn-bulk-collection"
                    onclick="narniaAddSessionToCollection('@_session.Id', this)">
                Add to Collection
            </button>
        </dd>
    </dl>

    <div id="worktree-advisories"
         class="worktree-advisories"
         data-session-id="@_session.Id"
         hidden></div>

    <details class="overrides-panel">
        <summary>✏️ Edit Session Overrides @(HasMetadataOverrides ? "(active)" : "")</summary>
        <div class="overrides-body">
            <p class="overrides-hint">
                Narnia aliases and metadata overrides are stored only in <code>settings.db</code>;
                they never modify Copilot files. Original Copilot values are shown below each field.
            </p>
            <div class="override-field">
                <label for="ov-display-name">Narnia Alias</label>
                <input id="ov-display-name" type="text" value="@(_override?.DisplayName ?? "")"
                       placeholder="@(CopilotName ?? "(unnamed session)")" />
                <span class="ov-original">
                    Copilot session-store name: @(_rawSession?.Summary ?? "(none)")
                </span>
                @if (_workspace?.Name is not null
                    && !string.Equals(_workspace.Name, _rawSession?.Summary, StringComparison.Ordinal))
                {
                    <span class="ov-original">Copilot workspace name: @_workspace.Name</span>
                }
            </div>
            <div class="override-field">
                <label for="ov-repo">Remote Repository (owner/repository)</label>
                <input id="ov-repo" type="text" value="@(_override?.Repository ?? "")"
                       placeholder="@(_rawSession?.Repository ?? "owner/repository")"
                       pattern="(?!\.\.?/)(?![A-Za-z0-9_.\-]+/\.\.?$)[A-Za-z0-9_.\-]+/[A-Za-z0-9_.\-]+"
                       title="Use owner/repository format, such as ncosentino/needlr." />
                <span class="ov-original">session-store remote repository: @(_rawSession?.Repository ?? "(none)")</span>
            </div>
            <div class="override-field">
                <label for="ov-branch">Branch</label>
                <input id="ov-branch" type="text" value="@(_override?.Branch ?? "")"
                       placeholder="@(_rawSession?.Branch ?? "(none)")" />
                <span class="ov-original">session-store branch: @(_rawSession?.Branch ?? "(none)")</span>
                <span class="ov-original">
                    A label only — it does not select which branch a launch lands on. Use the worktree
                    picker below to change that.
                </span>
            </div>
            <div class="override-field">
                <label for="ov-notes">Notes</label>
                <textarea id="ov-notes" rows="3" placeholder="Personal notes about this session…">@(_override?.Notes ?? "")</textarea>
            </div>
            <div class="override-field">
                <label for="ov-worktree">Git Worktree</label>
                <select id="ov-worktree" onchange="narniaApplyWorktree(this)" disabled>
                    <option value="">Checking for worktrees…</option>
                </select>
                <span class="ov-original">
                    Sets the resume directory and branch together, so the two cannot drift apart.
                    Narnia never checks a branch out — it only points this session at a worktree that
                    already exists.
                </span>
            </div>
            <div class="override-field">
                <label for="ov-local-path">Preferred Resume Directory</label>
                <input id="ov-local-path" type="text" value="@(_override?.LocalPath ?? "")"
                       placeholder="Preferred directory for launching this session" />
                <span class="ov-original">Used as the "Preferred Path" resume command, and preferred over the session-store working directory when launching</span>
            </div>
            <div class="override-field">
                <label for="ov-terminal-title">Terminal Title</label>
                <input id="ov-terminal-title" type="text" value="@(_override?.TerminalTitle ?? "")"
                       placeholder="@(_session.Summary ?? "(session name)")" />
                <span class="ov-original">Shown in the terminal title bar on launch; defaults to the effective session name.</span>
            </div>
            <div class="override-actions">
                <button class="btn-save" onclick="narniaSaveOverride('@_session.Id')">Save</button>
                @if (HasMetadataOverrides)
                {
                    <button class="btn-reset" onclick="narniaResetOverride('@_session.Id')">Reset Metadata</button>
                }
            </div>
        </div>
    </details>

    @if (_checkpoints is not null && _checkpoints.Length > 0)
    {
        <h2>Checkpoints</h2>

        @if (_checkpoints.Length > 1)
        {
            <div class="chart-container" style="max-height:200px">
                <canvas id="cp-cadence-chart"></canvas>
            </div>
            <script type="application/json" data-chart-id="cp-cadence-chart">
                @((MarkupString)BuildCadenceChartJson(_checkpoints))
            </script>
        }

        <div class="cp-timeline">
            @foreach (var cp in _checkpoints)
            {
                <div class="cp-timeline-entry">
                    <div class="cp-timeline-header">
                        <span class="cp-timeline-num">#@cp.CheckpointNumber</span>
                        @if (cp.Title is not null)
                        {
                            <span class="cp-timeline-title">@cp.Title</span>
                        }
                        <span class="cp-timeline-date">@cp.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</span>
                    </div>
                    @if (cp.Overview is not null)
                    {
                        <details class="cp-section" open>
                            <summary>Overview</summary>
                            <div class="cp-section-body"><p>@cp.Overview</p></div>
                        </details>
                    }
                    @if (cp.WorkDone is not null)
                    {
                        <details class="cp-section">
                            <summary>Work Done</summary>
                            <div class="cp-section-body"><pre>@cp.WorkDone</pre></div>
                        </details>
                    }
                    @if (cp.NextSteps is not null)
                    {
                        <details class="cp-section">
                            <summary>Next Steps</summary>
                            <div class="cp-section-body"><pre>@cp.NextSteps</pre></div>
                        </details>
                    }
                    @if (cp.ImportantFiles is not null)
                    {
                        <details class="cp-section">
                            <summary>Important Files</summary>
                            <div class="cp-section-body"><pre>@cp.ImportantFiles</pre></div>
                        </details>
                    }
                    @if (cp.History is not null)
                    {
                        <details class="cp-section">
                            <summary>History</summary>
                            <div class="cp-section-body"><pre>@cp.History</pre></div>
                        </details>
                    }
                </div>
            }
        </div>
    }

    @if (_workspace?.ArtifactFiles is { Length: > 0 } files)
    {
        <h2>Session Files</h2>
        <ul>
            @foreach (var f in files)
            {
                <li><code>@f</code></li>
            }
        </ul>
    }

    @if (_turns is not null && _turns.Length > 0)
    {
        <h2>Conversation (@_turns.Length turn@(_turns.Length == 1 ? "" : "s"))</h2>
        @foreach (var turn in _turns)
        {
            <div class="turn">
                <div class="turn-user">
                    <strong>You</strong>
                    <p>@turn.UserMessage</p>
                </div>
                @if (turn.AssistantResponse is not null)
                {
                    <div class="turn-assistant">
                        <strong>Copilot</strong>
                        <p>@turn.AssistantResponse</p>
                    </div>
                }
            </div>
        }
    }
}

@code {
    [Parameter]
    public string SessionId { get; set; } = "";

    private Session? _session;
    private Session? _rawSession;
    private SessionOverride? _override;
    private WorkspaceInfo? _workspace;
    private SessionStorageRecord? _storage;
    private Checkpoint[]? _checkpoints;
    private Turn[]? _turns;
    private IReadOnlyList<WorkCollection> _collections = [];
    private SessionResumeAssessment? _resumeAssessment;
    private SessionMigrationPreview? _migrationPreview;
    private SessionMigration? _relatedMigration;
    private CopilotSidebarWorkspace? _sidebar;
    private bool _loaded;
    private bool HasNarniaAlias => !string.IsNullOrWhiteSpace(_override?.DisplayName);
    private string? CopilotName => _workspace?.Name ?? _rawSession?.Summary;
    private bool HasCopilotNameProvenance => !string.IsNullOrWhiteSpace(_workspace?.Name);
    private bool HasMetadataOverrides =>
        _override is not null
        && (!string.IsNullOrWhiteSpace(_override.DisplayName)
            || !string.IsNullOrWhiteSpace(_override.Repository)
            || !string.IsNullOrWhiteSpace(_override.Branch)
            || !string.IsNullOrWhiteSpace(_override.Notes)
            || !string.IsNullOrWhiteSpace(_override.LocalPath)
            || !string.IsNullOrWhiteSpace(_override.TerminalTitle));
    private string _copilotCommand = CopilotSettingKeys.DefaultCommand;
    private bool IsMigrationSource =>
        _relatedMigration is not null &&
        string.Equals(
            _relatedMigration.SourceSessionId,
            SessionId,
            StringComparison.OrdinalIgnoreCase);
    private bool IsInPlaceMigration => _relatedMigration?.IsInPlace == true;

    /// <summary>
    /// Copilot keys its sidebar tab list on the working directory byte-for-byte, so this must be
    /// the raw store value rather than a Narnia local-path override.
    /// </summary>
    private string? SidebarCwd => _rawSession?.Cwd ?? _session?.Cwd;

    private CopilotSidebarTab? SidebarTabForThisSession =>
        _sidebar?.Tabs.FirstOrDefault(tab =>
            string.Equals(tab.SessionId, SessionId, StringComparison.OrdinalIgnoreCase));
    private bool IsMigrationReplacement =>
        _relatedMigration is not null &&
        string.Equals(
            _relatedMigration.ReplacementSessionId,
            SessionId,
            StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        _copilotCommand =
            await SettingsRepo.GetAsync(CopilotSettingKeys.Command) ??
            CopilotSettingKeys.DefaultCommand;
        _session = await Repository.GetByIdAsync(SessionId);
        if (_session is not null)
        {
            _rawSession = await RawRepository.GetByIdAsync(SessionId);
            _override = await OverridesRepository.GetOverrideAsync(SessionId);
            _workspace = WorkspaceReader.ReadWorkspace(SessionId);
            _storage = await StorageRepository.GetBySessionIdAsync(
                SessionId,
                CancellationToken.None);
            _collections = await CollectionsRepository.GetBySessionIdAsync(SessionId);
            _checkpoints = await Repository.GetCheckpointsAsync(SessionId);
            _turns = await Repository.GetTurnsAsync(SessionId, 0, 100);
            _resumeAssessment = ResumeSafetyReader.Inspect(SessionId);
            _relatedMigration = await MigrationService.GetRelatedAsync(
                SessionId,
                CancellationToken.None);
            if (!string.IsNullOrWhiteSpace(SidebarCwd))
            {
                _sidebar = await SidebarTabs.GetAsync(
                    SidebarCwd,
                    CancellationToken.None);
            }
            if (!IsMigrationReplacement)
            {
                _migrationPreview = await MigrationService.PreviewAsync(
                    SessionId,
                    CancellationToken.None);
            }
        }
        _loaded = true;
    }

    private RenderFragment RecoveryPlan => @<div class="session-recovery-plan">
            @if (_migrationPreview is null)
            {
                <p>Recovery details are unavailable.</p>
            }
            else
            {
                <p>
                    Narnia will archive only the broken <code>events.jsonl</code>, ask Copilot to
                    reseed this exact session ID and folder, and use one bootstrap response to
                    synthesize the recovered context. The original event stream is retained for
                    rollback and audit.
                </p>
                <div class="session-recovery-metrics">
                    <span><strong>@_migrationPreview.TurnCount</strong> turns</span>
                    <span><strong>@_migrationPreview.CheckpointCount</strong> checkpoints</span>
                    <span><strong>@_migrationPreview.TodoCount</strong> workspace tasks</span>
                </div>
                <p>
                    Existing artifacts, workspace tasks, checkpoints, rewind snapshots, favorite,
                    alias, notes, Collections, Session Groups, and saved windows remain attached to
                    this same session.
                </p>
                @if (_migrationPreview.ExistingMigration?.Status == SessionMigrationStatus.Completed)
                {
                    @if (_migrationPreview.ExistingMigration.IsInPlace)
                    {
                        <span class="storage-success">Recovery is complete in this session.</span>
                    }
                    else
                    {
                        <a class="launch-btn"
                           href="/sessions/@_migrationPreview.ExistingMigration.ReplacementSessionId">
                            Open recovered successor
                        </a>
                    }
                }
                else if (_migrationPreview.CanMigrate)
                {
                    <button class="launch-btn session-migrate-btn"
                            onclick="narniaMigrateSession('@SessionId', this)">
                        Recover this session in place
                    </button>
                }
                else
                {
                    <p class="session-recovery-error">@_migrationPreview.BlockingReason</p>
                }
            }
        </div>;

    private static string BuildCadenceChartJson(Checkpoint[] checkpoints) =>
        JsonSerializer.Serialize(new
        {
            type = "line",
            data = new
            {
                labels = checkpoints.Select(c => c.CreatedAt.LocalDateTime.ToString("HH:mm")).ToArray(),
                datasets = new[]
                {
                    new { label = "Checkpoint", data = checkpoints.Select(c => c.CheckpointNumber).ToArray(),
                          borderColor = "rgba(99,102,241,1)", backgroundColor = "rgba(99,102,241,0.1)",
                          pointBackgroundColor = "rgba(99,102,241,1)", tension = 0.3, fill = true }
                }
            },
            options = new
            {
                responsive = true,
                plugins = new { legend = new { display = false } },
                scales = new { y = new { beginAtZero = false, ticks = new { stepSize = 1 } } }
            }
        });

    private List<(string Label, string Command, string Target, string Index)> BuildResumeEntries()
    {
        var baseCmd = $"{_copilotCommand} --resume={_session!.Id}";
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var entries = new List<(string Label, string Command, string Target, string Index)>();

        // Always show the base command (no cd)
        entries.Add(("Resume", baseCmd, "none", $"{_session.Id}-0"));

        // Preferred path (override local path)
        if (!string.IsNullOrWhiteSpace(_override?.LocalPath))
        {
            var norm = NormalizePath(_override.LocalPath);
            if (seen.Add(norm))
            {
                entries.Add(("Preferred Path", $"cd \"{_override.LocalPath}\" && {baseCmd}", "localPath", $"{_session.Id}-1"));
            }
        }

        // CWD
        if (!string.IsNullOrWhiteSpace(_session.Cwd))
        {
            var norm = NormalizePath(_session.Cwd);
            if (seen.Add(norm))
            {
                entries.Add(("Working Dir", $"cd \"{_session.Cwd}\" && {baseCmd}", "cwd", $"{_session.Id}-2"));
            }
        }

        // Git Root
        var gitRoot = _workspace?.GitRoot ?? _session.GitRoot;
        if (!string.IsNullOrWhiteSpace(gitRoot))
        {
            var norm = NormalizePath(gitRoot);
            if (seen.Add(norm))
            {
                entries.Add(("Git Root", $"cd \"{gitRoot}\" && {baseCmd}", "gitRoot", $"{_session.Id}-3"));
            }
        }

        return entries;
    }

    private static string NormalizePath(string path)
    {
        return path.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
    }

    private static string ShortSession(string sessionId) =>
        sessionId.Length >= 8 ? sessionId[..8] : sessionId;

    private static string FormatMigrationStatus(SessionMigrationStatus status) =>
        status switch
        {
            SessionMigrationStatus.SessionCreated => "session created",
            SessionMigrationStatus.CleanupRequired => "cleanup required",
            _ => status.ToString().ToLowerInvariant(),
        };

    private static string FormatBytes(long bytes)
    {
        string[] units = ["B", "KiB", "MiB", "GiB", "TiB"];
        var value = (double)Math.Max(0, bytes);
        var unit = 0;
        while (value >= 1024 && unit < units.Length - 1)
        {
            value /= 1024;
            unit++;
        }
        return unit == 0 ? $"{value:0} {units[unit]}" : $"{value:0.##} {units[unit]}";
    }
}

@page "/stats"
@using NexusLabs.Narnia.Core.Models
@using NexusLabs.Narnia.Core.Repositories
@using System.Text.Json
@inject ISessionRepository Repository

<PageTitle>Stats — Narnia</PageTitle>

<h1>Stats</h1>

@if (_stats is null)
{
    <p>Loading...</p>
}
else
{
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-value">@_stats.TotalSessions</div>
            <div class="stat-label">Raw Sessions</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">@_stats.TotalTurns</div>
            <div class="stat-label">Turns</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">@_stats.AvgTurnsPerSession.ToString("F1")</div>
            <div class="stat-label">Avg Turns / Raw Session</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">@_stats.TotalFilesTouched</div>
            <div class="stat-label">Files Touched</div>
        </div>
        @if (_insights is not null)
        {
            <div class="stat-card">
                <div class="stat-value">@_insights.TotalCheckpoints</div>
                <div class="stat-label">Checkpoints</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">@_insights.DistinctRepositories</div>
                <div class="stat-label">Remote Repositories</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">@_insights.DistinctBranches</div>
                <div class="stat-label">Branches</div>
            </div>
        }
    </div>

    <div class="stats-grid">
        @if (_stats.MostActiveRepository is not null)
        {
            <div class="stat-card stat-card--wide">
                <div class="stat-value stat-value--sm">@_stats.MostActiveRepository</div>
                <div class="stat-label">Most Active Remote Repository</div>
            </div>
        }
        @if (_stats.BusiestDay is not null)
        {
            <div class="stat-card">
                <div class="stat-value stat-value--sm">@_stats.BusiestDay</div>
                <div class="stat-label">Busiest Day</div>
            </div>
        }
        @if (_patterns is not null)
        {
            <div class="stat-card">
                <div class="stat-value">@_patterns.CurrentStreakDays</div>
                <div class="stat-label">Current Streak (days)</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">@_patterns.LongestStreakDays</div>
                <div class="stat-label">Longest Streak (days)</div>
            </div>
        }
    </div>

    @if (_growth is { Length: > 0 })
    {
        <h2>Growth Over Time</h2>
        <p>Cumulative raw Copilot session records, turns, file touches, and checkpoints. Use the legend to show or hide a series.</p>
        <div class="chart-container">
            <canvas id="stats-growth-chart"></canvas>
        </div>
        <script type="application/json" data-chart-id="stats-growth-chart">
            @((MarkupString)BuildGrowthChartJson(_growth))
        </script>
    }

    @if (_recentActivity is not null)
    {
        <h2>Recent Raw Session Activity</h2>
        <p>
            These are raw Copilot session records, not a count of human work sessions. Automated
            tools and evaluation harnesses can create many short sessions.
        </p>
        <form method="get" action="/stats">
            <label>
                Days to show:
                <select name="days" onchange="this.form.submit()">
                    <option value="30" selected="@(SelectedDays == 30)">Last 30 days</option>
                    <option value="60" selected="@(SelectedDays == 60)">Last 60 days</option>
                    <option value="90" selected="@(SelectedDays == 90)">Last 90 days</option>
                    <option value="180" selected="@(SelectedDays == 180)">Last 180 days</option>
                    <option value="365" selected="@(SelectedDays == 365)">Last year</option>
                </select>
            </label>
            <button type="submit">Apply</button>
        </form>
        @if (_recentActivity.Length == 0)
        {
            <p>No sessions were recorded in this period.</p>
        }
        else
        {
            <div class="activity-summary">
                <span>Total: <strong>@_recentActivity.Sum(day => day.SessionCount) raw sessions</strong></span>
                <span>Active days: <strong>@_recentActivity.Length</strong></span>
                <span>
                    Peak: <strong>@PeakActivity.SessionCount raw sessions</strong> on
                    <a href="@ActivityDateUrl(PeakActivity.Date)">@PeakActivity.Date.ToString("yyyy-MM-dd")</a>
                </span>
            </div>
            <div class="chart-container">
                <canvas id="stats-activity-chart"></canvas>
            </div>
            <script type="application/json"
                    data-chart-id="stats-activity-chart"
                    data-chart-href-template="@ActivityDateNavigationTemplate">
                @((MarkupString)BuildActivityChartJson(_recentActivity))
            </script>

            @if (_selectedActivityDate is not null)
            {
                <h3 id="session-sources">Session sources for @_selectedActivityDate.Value.ToString("yyyy-MM-dd")</h3>
                @if (_activitySources.Length == 0)
                {
                    <p>No raw session records were found for this local date.</p>
                }
                else
                {
                    <p class="search-hint">
                        @_activitySources.Sum(source => source.SessionCount) raw session records,
                        grouped by recorded provenance. Generated GUID working directories are
                        collapsed into their parent directory.
                    </p>
                    <table class="sessions-table" data-resizable-table="stats-session-sources">
                        <thead>
                            <tr>
                                <th>Source</th>
                                <th>Type</th>
                                <th>Host</th>
                                <th>Raw Sessions</th>
                                <th>Inspect</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var source in _activitySources)
                            {
                                <tr>
                                    <td class="@(source.Kind == SessionActivitySourceKind.WorkingDirectory ? "cwd" : "")">@source.Label</td>
                                    <td>@FormatSourceKind(source.Kind)</td>
                                    <td>@(source.HostType ?? "not recorded")</td>
                                    <td>@source.SessionCount</td>
                                    <td><a href="@BuildSourceSessionUrl(source)">View sessions →</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
        }
    }

    @if (_insights is not null)
    {
        <h2>Session Composition</h2>
        <div class="chart-row">
            <div class="chart-container">
                <canvas id="stats-fileops-chart"></canvas>
            </div>
            <div class="chart-container">
                <canvas id="stats-origin-chart"></canvas>
            </div>
        </div>
        <script type="application/json" data-chart-id="stats-fileops-chart">
            @((MarkupString)BuildFileOpsChartJson(_insights))
        </script>
        <script type="application/json" data-chart-id="stats-origin-chart">
            @((MarkupString)BuildOriginChartJson(_insights))
        </script>
    }

    @if (_hotFiles is not null)
    {
        <h2>Most Touched Files</h2>
        <p>Recorded file paths ranked by the number of distinct Copilot sessions that touched them.</p>
        @if (_hotFiles.Length == 0)
        {
            <p>No file data has been recorded yet.</p>
        }
        else
        {
            <div class="chart-container">
                <canvas id="stats-hot-files-chart"></canvas>
            </div>
            <script type="application/json" data-chart-id="stats-hot-files-chart">
                @((MarkupString)BuildHotFilesChartJson(_hotFiles))
            </script>

            <table class="sessions-table" data-resizable-table="stats-hot-files">
                <thead>
                    <tr>
                        <th>File</th>
                        <th>Sessions</th>
                        <th>Latest Tool</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var file in _hotFiles)
                    {
                        <tr>
                            <td><a href="/files?path=@Uri.EscapeDataString(file.FilePath)" class="hot-file-path">@file.FilePath</a></td>
                            <td>@file.SessionCount</td>
                            <td>@(file.LastToolName ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    @if (_patterns is not null)
    {
        <h2>When You Work</h2>
        <p>Raw session creation times, in your local time zone.</p>
        <div class="chart-row">
            <div class="chart-container">
                <canvas id="stats-dow-chart"></canvas>
            </div>
            <div class="chart-container">
                <canvas id="stats-hour-chart"></canvas>
            </div>
        </div>
        <script type="application/json" data-chart-id="stats-dow-chart">
            @((MarkupString)BuildDayOfWeekChartJson(_patterns.ByDayOfWeek))
        </script>
        <script type="application/json" data-chart-id="stats-hour-chart">
            @((MarkupString)BuildHourChartJson(_patterns.ByHour))
        </script>
    }

    @if (_repoStats is { Length: > 0 })
    {
        <h2>Raw Sessions by Remote Repository</h2>
        <div class="chart-container">
            <canvas id="stats-repo-chart"></canvas>
        </div>
        <script type="application/json" data-chart-id="stats-repo-chart">
            @((MarkupString)BuildRepoChartJson(_repoStats))
        </script>
    }
}

@code {
    private GlobalStats? _stats;
    private RepositoryStats[]? _repoStats;
    private SessionInsights? _insights;
    private ActivityPatterns? _patterns;
    private ActivityTimelineDay[]? _growth;
    private ActivityDay[]? _recentActivity;
    private SessionActivitySource[] _activitySources = [];
    private DateOnly? _selectedActivityDate;
    private HotFile[]? _hotFiles;

    /// <summary>Gets or sets the recent-activity window selected through the query string.</summary>
    [SupplyParameterFromQuery(Name = "days")]
    public int Days { get; set; } = 90;

    /// <summary>Gets or sets the local activity date selected for source inspection.</summary>
    [SupplyParameterFromQuery(Name = "activityDate")]
    public string? ActivityDate { get; set; }

    private int SelectedDays => Days is 30 or 60 or 90 or 180 or 365 ? Days : 90;
    private ActivityDay PeakActivity =>
        _recentActivity!.OrderByDescending(day => day.SessionCount).ThenBy(day => day.Date).First();

    protected override async Task OnInitializedAsync()
    {
        var statsTask = Repository.GetGlobalStatsAsync().AsTask();
        var repoStatsTask = Repository.GetRepositoryStatsAsync().AsTask();
        var insightsTask = Repository.GetSessionInsightsAsync().AsTask();
        var patternsTask = Repository.GetActivityPatternsAsync().AsTask();
        var growthTask = Repository.GetActivityTimelineAsync(3650).AsTask();
        var hotFilesTask = Repository.GetHotFilesAsync(25).AsTask();
        await Task.WhenAll(statsTask, repoStatsTask, insightsTask, patternsTask, growthTask, hotFilesTask);

        _repoStats = await repoStatsTask;
        _stats = await statsTask;
        _insights = await insightsTask;
        _patterns = await patternsTask;
        _growth = await growthTask;
        _hotFiles = await hotFilesTask;

        var cutoff = DateOnly.FromDateTime(DateTime.Now.Date.AddDays(-SelectedDays));
        _recentActivity =
        [
            .. _growth
                .Where(day => day.Date >= cutoff && day.SessionCount > 0)
                .Select(day => new ActivityDay(day.Date, day.SessionCount)),
        ];

        if (_recentActivity.Length > 0)
        {
            _selectedActivityDate = DateOnly.TryParseExact(
                ActivityDate,
                "yyyy-MM-dd",
                out var selectedDate)
                ? selectedDate
                : PeakActivity.Date;
            _activitySources = await Repository.GetSessionActivitySourcesAsync(
                _selectedActivityDate.Value);
        }
    }

    private static string BuildRepoChartJson(RepositoryStats[] data) =>
        JsonSerializer.Serialize(new
        {
            type = "bar",
            data = new
            {
                labels = data.Select(r => r.Repository).ToArray(),
                datasets = new[]
                {
                    new { label = "Raw Sessions", data = data.Select(r => r.SessionCount).ToArray(),
                          backgroundColor = "rgba(99,102,241,0.7)", borderColor = "rgba(99,102,241,1)", borderWidth = 1 }
                }
            },
            options = new
            {
                responsive = true,
                plugins = new { legend = new { display = false } },
                scales = new { y = new { beginAtZero = true, ticks = new { stepSize = 1 } } }
            }
        });

    private static string BuildGrowthChartJson(ActivityTimelineDay[] data)
    {
        var sessions = BuildCumulative(data, static day => day.SessionCount);
        var turns = BuildCumulative(data, static day => day.TurnCount);
        var files = BuildCumulative(data, static day => day.FilesTouched);
        var checkpoints = BuildCumulative(data, static day => day.CheckpointCount);

        return JsonSerializer.Serialize(new
        {
            type = "line",
            data = new
            {
                labels = data.Select(d => d.Date.ToString("yyyy-MM-dd")).ToArray(),
                datasets = new[]
                {
                    new { label = "Total Raw Sessions", data = sessions, yAxisID = "y",
                          borderColor = "rgba(99,102,241,1)", backgroundColor = "rgba(99,102,241,0.1)",
                          pointRadius = 0, pointHoverRadius = 3, borderWidth = 2, tension = 0.2, fill = false },
                    new { label = "Total Turns", data = turns, yAxisID = "work",
                          borderColor = "rgba(249,115,22,1)", backgroundColor = "rgba(249,115,22,0.1)",
                          pointRadius = 0, pointHoverRadius = 3, borderWidth = 2, tension = 0.2, fill = false },
                    new { label = "Total Files Touched", data = files, yAxisID = "work",
                          borderColor = "rgba(16,185,129,1)", backgroundColor = "rgba(16,185,129,0.1)",
                          pointRadius = 0, pointHoverRadius = 3, borderWidth = 2, tension = 0.2, fill = false },
                    new { label = "Total Checkpoints", data = checkpoints, yAxisID = "y",
                          borderColor = "rgba(139,92,246,1)", backgroundColor = "rgba(139,92,246,0.1)",
                          pointRadius = 0, pointHoverRadius = 3, borderWidth = 2, tension = 0.2, fill = false }
                }
            },
            options = new
            {
                responsive = true,
                interaction = new { mode = "index", intersect = false },
                plugins = new { legend = new { display = true, position = "bottom" } },
                scales = new
                {
                    y = new
                    {
                        beginAtZero = true,
                        position = "left",
                        title = new { display = true, text = "Raw sessions / checkpoints" }
                    },
                    work = new
                    {
                        beginAtZero = true,
                        position = "right",
                        grid = new { drawOnChartArea = false },
                        title = new { display = true, text = "Turns / files touched" }
                    }
                }
            }
        });
    }

    private static int[] BuildCumulative(
        ActivityTimelineDay[] data,
        Func<ActivityTimelineDay, int> selectCount)
    {
        var total = 0;
        return data.Select(day => total += selectCount(day)).ToArray();
    }

    private static string BuildActivityChartJson(ActivityDay[] data) =>
        JsonSerializer.Serialize(new
        {
            type = "bar",
            data = new
            {
                labels = data.Select(day => day.Date.ToString("yyyy-MM-dd")).ToArray(),
                datasets = new[]
                {
                    new
                    {
                        label = "Raw Sessions",
                        data = data.Select(day => day.SessionCount).ToArray(),
                        backgroundColor = "rgba(99,102,241,0.7)",
                        borderColor = "rgba(99,102,241,1)",
                        borderWidth = 1,
                    },
                },
            },
            options = new
            {
                responsive = true,
                plugins = new { legend = new { display = false } },
                scales = new
                {
                    x = new { ticks = new { maxRotation = 45, minRotation = 45 } },
                    y = new { beginAtZero = true, ticks = new { stepSize = 1 } },
                },
            },
        });

    private string ActivityDateNavigationTemplate =>
        $"/stats?days={SelectedDays}&activityDate={{label}}#session-sources";

    private string ActivityDateUrl(DateOnly date) =>
        ActivityDateNavigationTemplate.Replace(
            "{label}",
            Uri.EscapeDataString(date.ToString("yyyy-MM-dd")),
            StringComparison.Ordinal);

    private string BuildSourceSessionUrl(SessionActivitySource source)
    {
        var parameters = new List<string>
        {
            $"createdDate={Uri.EscapeDataString(_selectedActivityDate!.Value.ToString("yyyy-MM-dd"))}",
            $"activitySourceKind={Uri.EscapeDataString(source.Kind.ToString())}",
            "showArchived=true",
        };
        if (source.Repository is not null)
            parameters.Add($"activitySource={Uri.EscapeDataString(source.Repository)}");
        else if (source.WorkingDirectory is not null)
        {
            parameters.Add($"activitySource={Uri.EscapeDataString(source.WorkingDirectory)}");
            if (source.IncludesDescendants)
                parameters.Add("activityGeneratedChildren=true");
        }
        if (source.HostType is not null)
            parameters.Add($"activityHostType={Uri.EscapeDataString(source.HostType)}");
        else
            parameters.Add("activityHostTypeMissing=true");

        return "/sessions?" + string.Join("&", parameters);
    }

    private static string FormatSourceKind(SessionActivitySourceKind kind) => kind switch
    {
        SessionActivitySourceKind.RemoteRepository => "Remote repository",
        SessionActivitySourceKind.WorkingDirectory => "Working directory",
        SessionActivitySourceKind.Host => "Host",
        _ => "Unknown",
    };

    private static string BuildFileOpsChartJson(SessionInsights insights) =>
        JsonSerializer.Serialize(new
        {
            type = "doughnut",
            data = new
            {
                labels = new[] { "Created", "Edited" },
                datasets = new[]
                {
                    new { data = new[] { insights.FilesCreated, insights.FilesEdited },
                          backgroundColor = new[] { "rgba(16,185,129,0.8)", "rgba(99,102,241,0.8)" },
                          borderColor = new[] { "rgba(16,185,129,1)", "rgba(99,102,241,1)" }, borderWidth = 1 }
                }
            },
            options = new
            {
                responsive = true,
                plugins = new { legend = new { position = "bottom" }, title = new { display = true, text = "File Operations" } }
            }
        });

    private static string BuildOriginChartJson(SessionInsights insights) =>
        JsonSerializer.Serialize(new
        {
            type = "doughnut",
            data = new
            {
                labels = new[] { "GitHub CLI (gh)", "Local Terminal" },
                datasets = new[]
                {
                    new { data = new[] { insights.GithubHostedSessions, insights.LocalTerminalSessions },
                          backgroundColor = new[] { "rgba(249,115,22,0.8)", "rgba(139,92,246,0.8)" },
                          borderColor = new[] { "rgba(249,115,22,1)", "rgba(139,92,246,1)" }, borderWidth = 1 }
                }
            },
            options = new
            {
                responsive = true,
                plugins = new { legend = new { position = "bottom" }, title = new { display = true, text = "Session Origin" } }
            }
        });

    private static string BuildHotFilesChartJson(HotFile[] data)
    {
        var top = data.Take(15).ToArray();
        return JsonSerializer.Serialize(new
        {
            type = "bar",
            data = new
            {
                labels = top.Select(file => System.IO.Path.GetFileName(file.FilePath)).ToArray(),
                datasets = new[]
                {
                    new
                    {
                        label = "Sessions",
                        data = top.Select(file => file.SessionCount).ToArray(),
                        backgroundColor = "rgba(16,185,129,0.7)",
                        borderColor = "rgba(16,185,129,1)",
                        borderWidth = 1,
                    },
                },
            },
            options = new
            {
                indexAxis = "y",
                responsive = true,
                plugins = new { legend = new { display = false } },
                scales = new { x = new { beginAtZero = true, ticks = new { stepSize = 1 } } },
            },
        });
    }

    private static string BuildDayOfWeekChartJson(IReadOnlyList<DayOfWeekActivity> data) =>
        JsonSerializer.Serialize(new
        {
            type = "bar",
            data = new
            {
                labels = data.Select(d => d.Day.ToString()[..3]).ToArray(),
                datasets = new[]
                {
                    new { label = "Sessions", data = data.Select(d => d.SessionCount).ToArray(),
                          backgroundColor = "rgba(99,102,241,0.7)", borderColor = "rgba(99,102,241,1)", borderWidth = 1 }
                }
            },
            options = new
            {
                responsive = true,
                plugins = new { legend = new { display = false }, title = new { display = true, text = "By Day of Week" } },
                scales = new { y = new { beginAtZero = true, ticks = new { stepSize = 1 } } }
            }
        });

    private static string BuildHourChartJson(IReadOnlyList<HourActivity> data) =>
        JsonSerializer.Serialize(new
        {
            type = "bar",
            data = new
            {
                labels = data.Select(h => $"{h.Hour:00}:00").ToArray(),
                datasets = new[]
                {
                    new { label = "Sessions", data = data.Select(h => h.SessionCount).ToArray(),
                          backgroundColor = "rgba(139,92,246,0.7)", borderColor = "rgba(139,92,246,1)", borderWidth = 1 }
                }
            },
            options = new
            {
                responsive = true,
                plugins = new { legend = new { display = false }, title = new { display = true, text = "By Hour of Day" } },
                scales = new { y = new { beginAtZero = true, ticks = new { stepSize = 1 } } }
            }
        });
}

    private static string BuildAgeSizeChartJson(
        IReadOnlyList<SessionStorageItem> sessions)
    {
        var now = DateTimeOffset.Now;
        var points = sessions
            .Where(item => item.Storage is { TotalBytes: > 0 } && ActivityAt(item) is not null)
            .OrderByDescending(item => item.Storage!.TotalBytes)
            .Take(100)
            .Select(item =>
            {
                var sizeMiB = item.Storage!.TotalBytes / 1024d / 1024d;
                return new
                {
                    Item = item,
                    X = Math.Max(0, (now - ActivityAt(item)!.Value).TotalDays),
                    Y = sizeMiB,
                    R = Math.Clamp(Math.Sqrt(sizeMiB) * 1.5, 4, 20),
                };
            })
            .ToArray();
        return JsonSerializer.Serialize(new
        {
            type = "bubble",
            narniaPointLabels = points.Select(point =>
                point.Item.Summary ?? ShortId(point.Item.SessionId)),
            data = new
            {
                datasets = new[]
                {
                    new
                    {
                        label = "Sessions",
                        data = points.Select(point => new
                        {
                            x = Math.Round(point.X, 1),
                            y = Math.Round(point.Y, 2),
                            r = Math.Round(point.R, 1),
                        }),
                        backgroundColor = "rgba(139,92,246,.55)",
                        borderColor = "#8b5cf6",
                    },
                },
            },
            options = new
            {
                responsive = true,
                maintainAspectRatio = false,
                plugins = new
                {
                    title = new { display = true, text = "Largest sessions: age × size" },
                    legend = new { display = false },
                },
                scales = new
                {
                    x = new
                    {
                        title = new { display = true, text = "Days since activity" },
                    },
                    y = new
                    {
                        beginAtZero = true,
                        title = new { display = true, text = "MiB" },
                    },
                },
            },
        });
    }

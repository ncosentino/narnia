@page "/search"
@using NexusLabs.Narnia.Core.Models
@using NexusLabs.Narnia.Core.Repositories
@inject ISessionSearch SearchService
@inject ISessionRepository Repository

<PageTitle>Search — Narnia</PageTitle>

<h1>Search</h1>

<form method="get" action="/search">
    <input type="search" name="q" value="@Query" placeholder="Search sessions, checkpoints, turns… (FTS5 syntax supported)" autofocus />
    <button type="submit">Search</button>
</form>

@if (!string.IsNullOrWhiteSpace(Query) && _results is null)
{
    <p>Searching…</p>
}
else if (_results is { Length: 0 })
{
    <p>No results for <strong>@Query</strong>.</p>
}
else if (_results is not null)
{
    <p>@_results.Length result(s) for <strong>@Query</strong></p>

    @foreach (var r in _results)
    {
        var session = _sessionMap.GetValueOrDefault(r.SessionId);
        <div class="search-result">
            <div class="search-result-header">
                <a href="/sessions/@r.SessionId">@(session?.Summary ?? r.SessionId)</a>
                <span class="source-type">@FormatSourceType(r.SourceType)</span>
                @if (session?.Repository is not null)
                {
                    <span class="source-type">@session.Repository</span>
                }
            </div>
            @if (session is not null)
            {
                <div class="search-result-meta">
                    Updated @session.UpdatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")
                    · @session.TurnCount turn(s) · @session.CheckpointCount checkpoint(s)
                </div>
            }
            <p class="search-result-snippet">@r.Content</p>
        </div>
    }
}
else
{
    <p class="search-hint">Try searching for a topic, technology, or task — e.g. <code>dependency injection</code>, <code>blazor*</code>, <code>fix AND tests</code>.</p>
}

@code {
    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    private SearchResult[]? _results;
    private Dictionary<string, SessionSummary> _sessionMap = [];

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Query))
            return;

        _results = await SearchService.SearchAsync(Query, 30);

        var ids = _results.Select(r => r.SessionId).Distinct().ToArray();
        var sessions = await Task.WhenAll(ids.Select(id => Repository.GetByIdAsync(id).AsTask()));
        _sessionMap = sessions
            .Where(s => s is not null)
            .ToDictionary(s => s!.Id, s => new SessionSummary(
                s!.Id, s.Cwd, s.Repository, s.Branch, s.Summary,
                s.CreatedAt, s.UpdatedAt, s.TurnCount, s.CheckpointCount));
    }

    private static string FormatSourceType(string? sourceType) => sourceType switch
    {
        "turn" => "💬 turn",
        "checkpoint_overview" => "📋 overview",
        "checkpoint_work_done" => "✅ work done",
        "checkpoint_next_steps" => "🔜 next steps",
        "checkpoint_technical" => "⚙️ technical",
        "checkpoint_history" => "📜 history",
        "checkpoint_files" => "📁 files",
        _ => sourceType ?? "unknown"
    };
}

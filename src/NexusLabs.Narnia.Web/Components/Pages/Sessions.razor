@page "/sessions"
@using NexusLabs.Narnia.Core.Models
@using NexusLabs.Narnia.Core.Repositories
@inject ISessionRepository Repository
@inject ISessionSearch Search
@inject ISessionOverridesRepository OverridesRepository

<PageTitle>Sessions — Narnia</PageTitle>

<div class="page-actions">
    <h1>Sessions</h1>
    <a href="@(string.IsNullOrWhiteSpace(Query) ? "/sessions" : $"/sessions?q={Uri.EscapeDataString(Query)}")" class="btn-refresh">↻ Refresh</a>
</div>

<form method="get" action="/sessions">
    <input type="search" name="q" value="@Query" placeholder="Search sessions..." />
    <label class="show-archived-label">
        <input type="checkbox" name="showArchived" value="true" @(ShowArchived ? "checked" : "") />
        Show archived
    </label>
    <button type="submit">Search</button>
</form>

@if (_sessions is not null && _sessions.Length > 0)
{
    <p>@_sessions.Length result(s)</p>
    <table class="sessions-table" id="sessions-table">
        <thead>
            <tr>
                <th class="col-select"><input type="checkbox" title="Select all" onclick="narniaToggleAll(this)" /></th>
                <th><a class="sort-link" href="@SortUrl(SessionSortColumn.Summary)" aria-label="@SortAriaLabel("Summary", SessionSortColumn.Summary)">Summary@(SortIndicator(SessionSortColumn.Summary))</a></th>
                <th>Status</th>
                <th><a class="sort-link" href="@SortUrl(SessionSortColumn.Repository)" aria-label="@SortAriaLabel("Repository", SessionSortColumn.Repository)">Repository@(SortIndicator(SessionSortColumn.Repository))</a></th>
                <th><a class="sort-link" href="@SortUrl(SessionSortColumn.Directory)" aria-label="@SortAriaLabel("Directory", SessionSortColumn.Directory)">Directory@(SortIndicator(SessionSortColumn.Directory))</a></th>
                <th><a class="sort-link" href="@SortUrl(SessionSortColumn.Turns)" aria-label="@SortAriaLabel("Turns", SessionSortColumn.Turns)">Turns@(SortIndicator(SessionSortColumn.Turns))</a></th>
                <th><a class="sort-link" href="@SortUrl(SessionSortColumn.Checkpoints)" aria-label="@SortAriaLabel("Checkpoints", SessionSortColumn.Checkpoints)">Checkpoints@(SortIndicator(SessionSortColumn.Checkpoints))</a></th>
                <th><a class="sort-link" href="@SortUrl(SessionSortColumn.Updated)" aria-label="@SortAriaLabel("Updated", SessionSortColumn.Updated)">Updated@(SortIndicator(SessionSortColumn.Updated))</a></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in _sessions)
            {
                var isArchived = _archivedIds?.Contains(s.Id) == true;
                string? nextStepsPreview = null;
                _resumableMap?.TryGetValue(s.Id, out nextStepsPreview);
                <tr class="@(isArchived ? "session-archived" : "")">
                    <td class="col-select"><input type="checkbox" class="session-check" value="@s.Id" onclick="narniaUpdateBulkBar()" /></td>
                    <td>
                        <a href="/sessions/@s.Id">@(s.Summary ?? "(no summary)")</a>
                        @if (isArchived)
                        {
                            <span class="badge-archived">archived</span>
                        }
                    </td>
                    <td class="col-status">
                        @if (nextStepsPreview is not null)
                        {
                            <span class="badge-remaining-work" title="@nextStepsPreview">remaining work</span>
                        }
                    </td>
                    <td>@(s.Repository ?? "—")</td>
                    <td class="cwd">@(s.Cwd ?? "—")</td>
                    <td>@s.TurnCount</td>
                    <td>@s.CheckpointCount</td>
                    <td>@s.UpdatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="bulk-action-bar" id="bulk-action-bar" style="display:none;">
        <span id="bulk-count">0 selected</span>
        <button class="btn-bulk-launch" onclick="narniaLaunchBulk()">🚀 Launch Selected</button>
        <button class="btn-bulk-archive" onclick="narniaArchiveBulk()">📦 Archive Selected</button>
    </div>
}
else if (_sessions is not null)
{
    <p>No results found.</p>
}

@if (_searchResults is not null && _searchResults.Length > 0)
{
    <h2>Search Matches</h2>
    @foreach (var r in _searchResults)
    {
        <div class="search-result">
            <a href="/sessions/@r.SessionId">@r.SessionId</a>
            <span class="source-type">@r.SourceType</span>
            <p>@r.Content</p>
        </div>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "showArchived")]
    public bool ShowArchived { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? Sort { get; set; }

    [SupplyParameterFromQuery(Name = "dir")]
    public string? Dir { get; set; }

    private SessionSummary[]? _sessions;
    private SearchResult[]? _searchResults;
    private HashSet<string>? _archivedIds;
    private Dictionary<string, string>? _resumableMap;

    private SessionSortColumn SortColumn => SessionSummarySorting.ParseColumn(Sort) ?? SessionSortColumn.Updated;
    private SessionSortDirection SortDirection => SessionSummarySorting.ParseDirection(Dir);

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Query))
        {
            _sessions = await Repository.ListRecentAsync(100, ShowArchived);
        }
        else
        {
            _searchResults = await Search.SearchAsync(Query, 20);

            var orderedIds = _searchResults
                .Select(r => r.SessionId)
                .Distinct()
                .ToArray();

            var sessions = await Task.WhenAll(
                orderedIds.Select(id => Repository.GetByIdAsync(id).AsTask()));

            var byId = sessions
                .Where(s => s is not null)
                .ToDictionary(s => s!.Id, s => s!);

            _sessions = orderedIds
                .Where(byId.ContainsKey)
                .Select(id => byId[id])
                .Select(s => new SessionSummary(
                    s.Id, s.Cwd, s.Repository, s.Branch, s.Summary,
                    s.CreatedAt, s.UpdatedAt, s.TurnCount, s.CheckpointCount))
                .ToArray();
        }

        if (ShowArchived)
            _archivedIds = await OverridesRepository.GetArchivedSessionIdsAsync();

        if (_sessions is { Length: > 0 } && SessionSummarySorting.ParseColumn(Sort) is not null)
            _sessions = SessionSummarySorting.Sort(_sessions, SortColumn, SortDirection);

        if (_sessions is { Length: > 0 })
            _resumableMap = await Repository.GetResumableSessionIdsAsync(
                _sessions.Select(s => s.Id).ToList());
    }

    private string SortUrl(SessionSortColumn column)
    {
        var nextDir = SessionSummarySorting.ParseColumn(Sort) == column && SortDirection == SessionSortDirection.Ascending
            ? "desc"
            : "asc";

        var parameters = new List<string>
        {
            $"sort={SessionSummarySorting.ToQueryValue(column)}",
            $"dir={nextDir}",
        };

        if (!string.IsNullOrWhiteSpace(Query))
            parameters.Add($"q={Uri.EscapeDataString(Query)}");

        if (ShowArchived)
            parameters.Add("showArchived=true");

        return "/sessions?" + string.Join("&", parameters);
    }

    private string SortIndicator(SessionSortColumn column)
    {
        if (SessionSummarySorting.ParseColumn(Sort) != column)
            return string.Empty;

        return SortDirection == SessionSortDirection.Ascending ? " ▲" : " ▼";
    }

    private string SortAriaLabel(string columnName, SessionSortColumn column)
    {
        if (SessionSummarySorting.ParseColumn(Sort) != column)
            return $"Sort by {columnName}";

        var current = SortDirection == SessionSortDirection.Ascending ? "ascending" : "descending";
        return $"Sort by {columnName}, currently sorted {current}";
    }
}

@page "/sessions"
@page "/favorites"
@using NexusLabs.Narnia.Core.Models
@using NexusLabs.Narnia.Core.Repositories
@inject ISessionRepository Repository
@inject ISessionSearch Search
@inject ISessionOverridesRepository OverridesRepository
@inject NavigationManager Navigation

<PageTitle>@PageHeading — Narnia</PageTitle>

<div class="page-actions">
    <h1>@PageHeading</h1>
    <a href="@RefreshUrl" class="btn-refresh">↻ Refresh</a>
</div>

<form method="get" action="@PagePath" class="session-search-form">
    <input type="search"
           name="q"
           value="@Query"
           placeholder="Search session content..."
           aria-label="Search session content" />
    @if (HasRepositoryFilter)
    {
        <input type="hidden" name="repository" value="@RepositoryFilter" />
    }
    @if (HasWorkingDirectoryFilter)
    {
        <input type="hidden" name="cwd" value="@WorkingDirectoryFilter" />
    }
    @if (HasActivitySourceFilter)
    {
        <input type="hidden" name="activitySourceKind" value="@ActivitySourceKindFilter" />
        @if (!string.IsNullOrWhiteSpace(ActivitySourceFilter))
        {
            <input type="hidden" name="activitySource" value="@ActivitySourceFilter" />
        }
        @if (ActivityGeneratedChildren)
        {
            <input type="hidden" name="activityGeneratedChildren" value="true" />
        }
        @if (!string.IsNullOrWhiteSpace(ActivityHostTypeFilter))
        {
            <input type="hidden" name="activityHostType" value="@ActivityHostTypeFilter" />
        }
        @if (ActivityHostTypeMissing)
        {
            <input type="hidden" name="activityHostTypeMissing" value="true" />
        }
    }
    @if (HasCreatedDateFilter)
    {
        <input type="hidden" name="createdDate" value="@CreatedDateFilter" />
    }
    @if (ExplicitSortColumn is not null)
    {
        <input type="hidden" name="sort" value="@SessionSummarySorting.ToQueryValue(ExplicitSortColumn.Value)" />
        <input type="hidden" name="dir" value="@(SortDirection == SessionSortDirection.Ascending ? "asc" : "desc")" />
    }
    <label class="show-archived-label">
        <input type="checkbox" name="showArchived" value="true" checked="@ShowArchived" />
        Show archived
    </label>
    @if (!IsFavoritesPage)
    {
        <label class="show-archived-label">
            <input type="checkbox" name="favoritesOnly" value="true" checked="@FavoritesOnly" />
            Favorites only
        </label>
    }
    <button type="submit">Search</button>
</form>

@if (HasRepositoryFilter || HasWorkingDirectoryFilter || HasActivitySourceFilter || HasCreatedDateFilter)
{
    <div class="session-scope">
        @if (HasRepositoryFilter)
        {
            <span><strong>Remote repository:</strong> @RepositoryFilter</span>
        }
        @if (HasWorkingDirectoryFilter)
        {
            <span><strong>Working directory:</strong> <code>@WorkingDirectoryFilter</code></span>
        }
        @if (HasActivitySourceFilter)
        {
            <span><strong>Recorded source:</strong> <code>@ActivitySourceDisplay</code></span>
        }
        @if (HasCreatedDateFilter)
        {
            <span><strong>Created on:</strong> @CreatedDateFilter</span>
        }
        <a href="@ClearScopeFiltersUrl">Clear filters</a>
    </div>
}

@if (HasContentSearch)
{
    <p class="search-hint">
        Content search scans summaries, conversations, checkpoints, and workspace artifacts.
        Repository, working-directory, and creation-date constraints are applied as structured
        filters instead of keyword search.
    </p>
}

@if (_sessions is not null && _sessions.Length > 0)
{
    <p class="session-result-count">
        <strong>@_totalResults result(s)</strong>
        @if (_totalResults > _sessions.Length)
        {
            <span> — showing @FirstVisibleResult–@LastVisibleResult</span>
        }
        @if (HasContentSearch && ExplicitSortColumn is null)
        {
            <span> — ranked by relevance</span>
        }
    </p>
    <table class="sessions-table" id="sessions-table" data-resizable-table="sessions">
        <thead>
            <tr>
                <th class="col-select" data-no-resize><input type="checkbox" title="Select all" onclick="narniaToggleAll(this)" /></th>
                <th class="col-favorite"><a class="sort-link" href="@SortUrl(SessionSortColumn.Favorite)" aria-label="@SortAriaLabel("Favorite", SessionSortColumn.Favorite)">Favorite@(SortIndicator(SessionSortColumn.Favorite))</a></th>
                <th><a class="sort-link" href="@SortUrl(SessionSortColumn.Summary)" aria-label="@SortAriaLabel("Summary", SessionSortColumn.Summary)">Summary@(SortIndicator(SessionSortColumn.Summary))</a></th>
                <th>Status</th>
                <th><a class="sort-link" href="@SortUrl(SessionSortColumn.Repository)" aria-label="@SortAriaLabel("Remote Repository", SessionSortColumn.Repository)">Remote Repository@(SortIndicator(SessionSortColumn.Repository))</a></th>
                <th><a class="sort-link" href="@SortUrl(SessionSortColumn.Directory)" aria-label="@SortAriaLabel("Working Directory", SessionSortColumn.Directory)">Working Directory@(SortIndicator(SessionSortColumn.Directory))</a></th>
                <th><a class="sort-link" href="@SortUrl(SessionSortColumn.Turns)" aria-label="@SortAriaLabel("Turns", SessionSortColumn.Turns)">Turns@(SortIndicator(SessionSortColumn.Turns))</a></th>
                <th><a class="sort-link" href="@SortUrl(SessionSortColumn.Checkpoints)" aria-label="@SortAriaLabel("Checkpoints", SessionSortColumn.Checkpoints)">Checkpoints@(SortIndicator(SessionSortColumn.Checkpoints))</a></th>
                <th><a class="sort-link" href="@SortUrl(SessionSortColumn.Updated)" aria-label="@SortAriaLabel("Updated", SessionSortColumn.Updated)">Updated@(SortIndicator(SessionSortColumn.Updated))</a></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in _sessions)
            {
                var isArchived = _archivedIds?.Contains(s.Id) == true;
                string? nextStepsPreview = null;
                _resumableMap?.TryGetValue(s.Id, out nextStepsPreview);
                <tr class="@(isArchived ? "session-archived" : "")">
                    <td class="col-select"><input type="checkbox" class="session-check" value="@s.Id" onclick="narniaUpdateBulkBar()" /></td>
                    <td class="col-favorite"><FavoriteButton SessionId="@s.Id" IsFavorite="@s.IsFavorite" /></td>
                    <td>
                        <a href="/sessions/@s.Id">@(s.Summary ?? "(no summary)")</a>
                        @if (isArchived)
                        {
                            <span class="badge-archived">archived</span>
                        }
                    </td>
                    <td class="col-status">
                        @if (nextStepsPreview is not null)
                        {
                            <span class="badge-remaining-work" title="@nextStepsPreview">remaining work</span>
                        }
                    </td>
                    <td><SessionFilterLink FilterName="repository" Value="@s.Repository" Href="@BuildFilterUrl("repository", s.Repository)" /></td>
                    <td><SessionFilterLink FilterName="cwd" Value="@s.Cwd" CssClass="cwd" Href="@BuildFilterUrl("cwd", s.Cwd)" /></td>
                    <td>@s.TurnCount</td>
                    <td>@s.CheckpointCount</td>
                    <td>@s.UpdatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>

    @if (_totalPages > 1)
    {
        <nav class="session-pagination" aria-label="Session result pages">
            @if (_currentPage > 1)
            {
                <a href="@PageUrl(_currentPage - 1)">← Previous</a>
            }
            <span>Page @_currentPage of @_totalPages</span>
            @if (_currentPage < _totalPages)
            {
                <a href="@PageUrl(_currentPage + 1)">Next →</a>
            }
        </nav>
    }

    <div class="bulk-action-bar" id="bulk-action-bar" style="display:none;">
        <span id="bulk-count">0 selected</span>
        <button class="btn-bulk-launch" onclick="narniaLaunchBulk()">🚀 Launch Selected</button>
        <button class="btn-bulk-archive" onclick="narniaArchiveBulk()">📦 Archive Selected</button>
        <button class="btn-bulk-group" onclick="narniaSaveSessionsAsGroup(this)">💾 Save as Group</button>
    </div>
}
else if (_sessions is not null)
{
    <p>@(EffectiveFavoritesOnly ? "No favorite sessions found." : "No results found.")</p>
}

@if (_searchResults is not null && _searchResults.Length > 0)
{
    <h2>Match Context</h2>
    <p class="search-hint">The strongest content match for each result shown on this page.</p>
    @foreach (var r in _searchResults)
    {
        _sessionsById.TryGetValue(r.SessionId, out var session);
        <div class="search-result">
            <div class="search-result-header">
                <a href="/sessions/@r.SessionId">@(session?.Summary ?? "(no summary)")</a>
                <span class="source-type">@FormatSourceType(r.SourceType)</span>
            </div>
            @if (session is not null)
            {
                <div class="search-result-meta">
                    @(session.Repository ?? "No remote repository") ·
                    @(session.Cwd ?? "No working directory") ·
                    updated @session.UpdatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")
                </div>
            }
            <p class="search-result-snippet">@r.Content</p>
        </div>
    }
}

@code {
    /// <summary>Gets or sets the full-text content query.</summary>
    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    /// <summary>Gets or sets whether archived sessions are included.</summary>
    [SupplyParameterFromQuery(Name = "showArchived")]
    public bool ShowArchived { get; set; }

    /// <summary>Gets or sets whether only favorite sessions are included.</summary>
    [SupplyParameterFromQuery(Name = "favoritesOnly")]
    public bool FavoritesOnly { get; set; }

    /// <summary>Gets or sets the exact effective remote-repository filter.</summary>
    [SupplyParameterFromQuery(Name = "repository")]
    public string? RepositoryFilter { get; set; }

    /// <summary>Gets or sets the exact recorded working-directory filter.</summary>
    [SupplyParameterFromQuery(Name = "cwd")]
    public string? WorkingDirectoryFilter { get; set; }

    /// <summary>Gets or sets the local session-creation date filter in yyyy-MM-dd form.</summary>
    [SupplyParameterFromQuery(Name = "createdDate")]
    public string? CreatedDateFilter { get; set; }

    /// <summary>Gets or sets the recorded activity-source kind filter.</summary>
    [SupplyParameterFromQuery(Name = "activitySourceKind")]
    public string? ActivitySourceKindFilter { get; set; }

    /// <summary>Gets or sets the recorded repository or working-directory source value.</summary>
    [SupplyParameterFromQuery(Name = "activitySource")]
    public string? ActivitySourceFilter { get; set; }

    /// <summary>Gets or sets whether generated direct child directories are matched.</summary>
    [SupplyParameterFromQuery(Name = "activityGeneratedChildren")]
    public bool ActivityGeneratedChildren { get; set; }

    /// <summary>Gets or sets the recorded host type filter.</summary>
    [SupplyParameterFromQuery(Name = "activityHostType")]
    public string? ActivityHostTypeFilter { get; set; }

    /// <summary>Gets or sets whether sessions with no recorded host type are matched.</summary>
    [SupplyParameterFromQuery(Name = "activityHostTypeMissing")]
    public bool ActivityHostTypeMissing { get; set; }

    /// <summary>Gets or sets the requested sort column.</summary>
    [SupplyParameterFromQuery(Name = "sort")]
    public string? Sort { get; set; }

    /// <summary>Gets or sets the requested sort direction.</summary>
    [SupplyParameterFromQuery(Name = "dir")]
    public string? Dir { get; set; }

    /// <summary>Gets or sets the one-based result page.</summary>
    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    private const int PageSize = 100;
    private SessionSummary[]? _sessions;
    private SearchResult[]? _searchResults;
    private HashSet<string>? _archivedIds;
    private Dictionary<string, string>? _resumableMap;
    private Dictionary<string, SessionSummary> _sessionsById = [];
    private int _totalResults;
    private int _totalPages;
    private int _currentPage = 1;

    private bool IsFavoritesPage =>
        string.Equals(
            new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/'),
            "/favorites",
            StringComparison.OrdinalIgnoreCase);
    private bool EffectiveFavoritesOnly => IsFavoritesPage || FavoritesOnly;
    private string PagePath => IsFavoritesPage ? "/favorites" : "/sessions";
    private string PageHeading => IsFavoritesPage
        ? "Favorite Sessions"
        : HasCreatedDateFilter
            ? $"Sessions on {CreatedDateFilter}"
            : "Sessions";
    private bool HasContentSearch => !string.IsNullOrWhiteSpace(Query);
    private bool HasRepositoryFilter => !string.IsNullOrWhiteSpace(RepositoryFilter);
    private bool HasWorkingDirectoryFilter =>
        !HasRepositoryFilter
        && !string.IsNullOrWhiteSpace(WorkingDirectoryFilter);
    private bool HasCreatedDateFilter => TryGetCreatedDate(out _);
    private bool HasActivitySourceFilter => TryGetActivitySourceFilter(out _);
    private string ActivitySourceDisplay =>
        ActivityGeneratedChildren
            ? $"{ActivitySourceFilter}\\*"
            : ActivitySourceFilter
              ?? ActivityHostTypeFilter
              ?? ActivitySourceKindFilter
              ?? "unknown";
    private SessionSortColumn? ExplicitSortColumn => SessionSummarySorting.ParseColumn(Sort);
    private SessionSortColumn? DisplaySortColumn => ExplicitSortColumn
        ?? (HasContentSearch ? null : SessionSortColumn.Updated);
    private SessionSortDirection SortDirection => SessionSummarySorting.ParseDirection(Dir);
    private int FirstVisibleResult => ((_currentPage - 1) * PageSize) + 1;
    private int LastVisibleResult => Math.Min(_currentPage * PageSize, _totalResults);
    private string RefreshUrl => BuildUrl(_currentPage);
    private string ClearScopeFiltersUrl => BuildUrl(
        page: 1,
        includeExactFilters: false,
        includeCreatedDateFilter: false);

    protected override async Task OnInitializedAsync()
    {
        var sessions = await LoadScopedSessionsAsync();
        if (!HasActivitySourceFilter && TryGetCreatedDate(out var createdDate))
        {
            sessions =
            [
                .. sessions.Where(session =>
                    DateOnly.FromDateTime(session.CreatedAt.LocalDateTime.Date) == createdDate),
            ];
        }
        if (EffectiveFavoritesOnly)
            sessions = sessions.Where(session => session.IsFavorite).ToArray();

        SearchResult[]? allSearchResults = null;

        if (HasContentSearch)
        {
            allSearchResults = await Search.SearchAsync(
                Query!,
                int.MaxValue,
                ShowArchived);
            var searchOrder = allSearchResults
                .Select((result, index) => (SessionId: result.SessionId, Index: index))
                .ToDictionary(entry => entry.SessionId, entry => entry.Index, StringComparer.Ordinal);

            sessions = sessions
                .Where(session => searchOrder.ContainsKey(session.Id))
                .ToArray();

            if (ExplicitSortColumn is null)
                sessions = sessions.OrderBy(session => searchOrder[session.Id]).ToArray();
        }

        if (ExplicitSortColumn is not null)
            sessions = SessionSummarySorting.Sort(sessions, ExplicitSortColumn.Value, SortDirection);

        _totalResults = sessions.Length;
        _totalPages = Math.Max(1, (int)Math.Ceiling(_totalResults / (double)PageSize));
        _currentPage = Math.Clamp(Page, 1, _totalPages);
        _sessions = sessions
            .Skip((_currentPage - 1) * PageSize)
            .Take(PageSize)
            .ToArray();
        _sessionsById = _sessions.ToDictionary(session => session.Id, StringComparer.Ordinal);

        if (allSearchResults is not null)
        {
            var visibleOrder = _sessions
                .Select((session, index) => (session.Id, Index: index))
                .ToDictionary(entry => entry.Id, entry => entry.Index, StringComparer.Ordinal);
            _searchResults = allSearchResults
                .Where(result => visibleOrder.ContainsKey(result.SessionId))
                .OrderBy(result => visibleOrder[result.SessionId])
                .ToArray();
        }

        if (ShowArchived)
            _archivedIds = await OverridesRepository.GetArchivedSessionIdsAsync();

        if (_sessions is { Length: > 0 })
            _resumableMap = await Repository.GetResumableSessionIdsAsync(
                _sessions.Select(s => s.Id).ToList());
    }

    private async Task<SessionSummary[]> LoadScopedSessionsAsync()
    {
        if (TryGetActivitySourceFilter(out var activitySource))
        {
            return await Repository.ListByActivitySourceAsync(
                activitySource,
                ShowArchived);
        }

        if (HasRepositoryFilter)
            return await Repository.ListByRepositoryAsync(RepositoryFilter!, ShowArchived);

        if (HasWorkingDirectoryFilter)
            return await Repository.ListByCwdAsync(WorkingDirectoryFilter!, ShowArchived);

        return await Repository.ListAllAsync(ShowArchived);
    }

    private string SortUrl(SessionSortColumn column)
    {
        var nextDirection = DisplaySortColumn == column
            ? SortDirection == SessionSortDirection.Ascending
                ? SessionSortDirection.Descending
                : SessionSortDirection.Ascending
            : DefaultDirection(column);
        return BuildUrl(page: 1, sortColumn: column, sortDirection: nextDirection);
    }

    private string SortIndicator(SessionSortColumn column)
    {
        if (DisplaySortColumn != column)
            return string.Empty;

        return SortDirection == SessionSortDirection.Ascending ? " ▲" : " ▼";
    }

    private string SortAriaLabel(string columnName, SessionSortColumn column)
    {
        if (DisplaySortColumn != column)
            return $"Sort by {columnName}";

        var current = SortDirection == SessionSortDirection.Ascending ? "ascending" : "descending";
        return $"Sort by {columnName}, currently sorted {current}";
    }

    private string PageUrl(int page) => BuildUrl(page);

    private string BuildUrl(
        int page,
        SessionSortColumn? sortColumn = null,
        SessionSortDirection? sortDirection = null,
        bool includeExactFilters = true,
        bool includeCreatedDateFilter = true,
        string? exactFilterName = null,
        string? exactFilterValue = null)
    {
        var parameters = new List<string>();
        if (HasContentSearch)
            parameters.Add($"q={Uri.EscapeDataString(Query!)}");

        if (exactFilterName is not null && exactFilterValue is not null)
        {
            parameters.Add($"{exactFilterName}={Uri.EscapeDataString(exactFilterValue)}");
        }
        else if (includeExactFilters)
        {
            if (HasRepositoryFilter)
                parameters.Add($"repository={Uri.EscapeDataString(RepositoryFilter!)}");

            if (HasWorkingDirectoryFilter)
                parameters.Add($"cwd={Uri.EscapeDataString(WorkingDirectoryFilter!)}");

            if (HasActivitySourceFilter)
            {
                parameters.Add($"activitySourceKind={Uri.EscapeDataString(ActivitySourceKindFilter!)}");
                if (!string.IsNullOrWhiteSpace(ActivitySourceFilter))
                    parameters.Add($"activitySource={Uri.EscapeDataString(ActivitySourceFilter)}");
                if (ActivityGeneratedChildren)
                    parameters.Add("activityGeneratedChildren=true");
                if (!string.IsNullOrWhiteSpace(ActivityHostTypeFilter))
                    parameters.Add($"activityHostType={Uri.EscapeDataString(ActivityHostTypeFilter)}");
                if (ActivityHostTypeMissing)
                    parameters.Add("activityHostTypeMissing=true");
            }
        }

        if (includeCreatedDateFilter && HasCreatedDateFilter)
            parameters.Add($"createdDate={Uri.EscapeDataString(CreatedDateFilter!)}");

        var column = sortColumn ?? ExplicitSortColumn;
        if (column is not null)
        {
            parameters.Add($"sort={SessionSummarySorting.ToQueryValue(column.Value)}");
            var direction = sortDirection ?? SortDirection;
            parameters.Add($"dir={(direction == SessionSortDirection.Ascending ? "asc" : "desc")}");
        }

        if (ShowArchived)
            parameters.Add("showArchived=true");

        if (!IsFavoritesPage && FavoritesOnly)
            parameters.Add("favoritesOnly=true");

        if (page > 1)
            parameters.Add($"page={page}");

        return parameters.Count == 0
            ? PagePath
            : PagePath + "?" + string.Join("&", parameters);
    }

    private string? BuildFilterUrl(string filterName, string? value) =>
        value is null
            ? null
            : BuildUrl(
                page: 1,
                includeExactFilters: false,
                exactFilterName: filterName,
                exactFilterValue: value);

    private bool TryGetCreatedDate(out DateOnly date) =>
        DateOnly.TryParseExact(
            CreatedDateFilter,
            "yyyy-MM-dd",
            out date);

    private bool TryGetActivitySourceFilter(out SessionActivitySourceFilter filter)
    {
        filter = null!;
        if (!TryGetCreatedDate(out var date)
            || !Enum.TryParse<SessionActivitySourceKind>(
                ActivitySourceKindFilter,
                ignoreCase: true,
                out var kind))
        {
            return false;
        }

        var source = string.IsNullOrWhiteSpace(ActivitySourceFilter)
            ? null
            : ActivitySourceFilter;
        if ((kind is SessionActivitySourceKind.RemoteRepository
                or SessionActivitySourceKind.WorkingDirectory)
            && source is null)
        {
            return false;
        }

        filter = new SessionActivitySourceFilter(
            date,
            kind,
            kind == SessionActivitySourceKind.RemoteRepository ? source : null,
            kind == SessionActivitySourceKind.WorkingDirectory ? source : null,
            ActivityGeneratedChildren,
            string.IsNullOrWhiteSpace(ActivityHostTypeFilter) ? null : ActivityHostTypeFilter,
            ActivityHostTypeMissing);
        return true;
    }

    private static SessionSortDirection DefaultDirection(SessionSortColumn column) =>
        column is SessionSortColumn.Summary or SessionSortColumn.Repository or SessionSortColumn.Directory
            ? SessionSortDirection.Ascending
            : SessionSortDirection.Descending;

    private static string FormatSourceType(string? sourceType) =>
        string.IsNullOrWhiteSpace(sourceType)
            ? "content"
            : sourceType.Replace('_', ' ');
}

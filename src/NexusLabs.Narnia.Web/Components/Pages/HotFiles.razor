@page "/analytics/hot-files"
@using NexusLabs.Narnia.Core.Models
@using NexusLabs.Narnia.Core.Repositories
@using System.Text.Json
@inject ISessionRepository Repository

<PageTitle>Hot Files — Narnia</PageTitle>

<h1>Hot Files</h1>
<p>Files touched across the most sessions.</p>

@if (_files is null)
{
    <p>Loading...</p>
}
else if (_files.Length == 0)
{
    <p>No file data recorded yet.</p>
}
else
{
    <div class="chart-container">
        <canvas id="hotfiles-chart"></canvas>
    </div>
    <script type="application/json" data-chart-id="hotfiles-chart">
        @((MarkupString)BuildChartJson(_files))
    </script>

    <table class="sessions-table" data-resizable-table="hot-files">
        <thead>
            <tr>
                <th>File</th>
                <th>Sessions</th>
                <th>Last Tool</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var f in _files)
            {
                <tr>
                    <td><a href="/files?path=@Uri.EscapeDataString(f.FilePath)" class="hot-file-path">@f.FilePath</a></td>
                    <td>@f.SessionCount</td>
                    <td>@(f.LastToolName ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private HotFile[]? _files;

    protected override async Task OnInitializedAsync()
    {
        _files = await Repository.GetHotFilesAsync(25);
    }

    private static string BuildChartJson(HotFile[] data)
    {
        var top = data.Take(15).ToArray();
        return JsonSerializer.Serialize(new
        {
            type = "bar",
            data = new
            {
                labels = top.Select(f => System.IO.Path.GetFileName(f.FilePath)).ToArray(),
                datasets = new[]
                {
                    new { label = "Sessions", data = top.Select(f => f.SessionCount).ToArray(),
                          backgroundColor = "rgba(16,185,129,0.7)", borderColor = "rgba(16,185,129,1)", borderWidth = 1 }
                }
            },
            options = new
            {
                indexAxis = "y",
                responsive = true,
                plugins = new { legend = new { display = false } },
                scales = new { x = new { beginAtZero = true, ticks = new { stepSize = 1 } } }
            }
        });
    }
}

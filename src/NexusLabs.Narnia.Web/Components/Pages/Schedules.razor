@page "/schedules"
@using NexusLabs.Narnia.Core.Models
@using NexusLabs.Narnia.Core.Repositories
@using NexusLabs.Narnia.Core.Services
@inject IScheduledJobService JobService
@inject IScheduledJobImportRepository ImportRepository

<PageTitle>Scheduled Jobs — Narnia</PageTitle>

<div class="page-actions">
    <h1>⏱️ Scheduled Jobs</h1>
    <a href="/schedules" class="btn-refresh">↻ Refresh</a>
</div>

<div id="sched-log-panel" class="sched-log-panel" style="display:none;">
    <div class="page-actions">
        <h3 id="sched-log-title">Log</h3>
        <button class="btn-refresh" onclick="narniaScheduleStopLogPolling(); document.getElementById('sched-log-panel').style.display='none'">✕ Close</button>
    </div>
    <p id="sched-log-meta" class="settings-hint"></p>
    <textarea id="sched-log-content" readonly></textarea>
</div>

<p class="settings-hint">
    A catalog of your scheduled Copilot jobs. Narnia is a registry only — <strong>Windows Task
    Scheduler still runs everything</strong>; this page joins each cataloged job to what the
    scheduler actually reports (last run, next run, result) and flags anything that has drifted.
    @if (!_schedulerSupported)
    {
        <span class="schedule-warn">Live task status is unavailable on this platform.</span>
    }
</p>

@if (_jobs.Count == 0 && _untracked.Count == 0)
{
    <p>
        No scheduled jobs cataloged yet. Once a job is registered under the Narnia standard it will
        appear here with its live status.
    </p>
}

@if (_jobs.Count > 0)
{
    <div class="schedule-package-toolbar">
        <h2>Cataloged <span class="window-meta">@_jobs.Count job@(_jobs.Count == 1 ? "" : "s")</span></h2>
        <div>
            <button id="sched-export-transfer" class="btn-refresh" disabled onclick="narniaScheduleExportPackage('transfer')">Export for transfer</button>
            <button id="sched-export-share" class="btn-refresh" disabled onclick="narniaScheduleExportPackage('share')">Export share template</button>
        </div>
    </div>
    <table class="schedule-table" data-resizable-table="scheduled-jobs">
        <thead>
            <tr>
                <th class="schedule-select"><input id="sched-package-check-all" type="checkbox" onchange="narniaScheduleTogglePackageSelection(this)" title="Select all jobs for export" /></th>
                <th>Job</th>
                <th>Cadence</th>
                <th>Health</th>
                <th>Last run</th>
                <th>Next run</th>
                <th>Working dir</th>
                <th>Skills</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var view in _jobs)
            {
                <tr>
                    <td class="schedule-select"><input class="sched-package-check" type="checkbox" value="@view.Job.Id" onchange="narniaSchedulePackageSelectionChanged()" /></td>
                    <td>
                        <div class="schedule-name">@view.Job.Name</div>
                        <div class="schedule-sub">
                            <span class="schedule-task">@view.Job.TaskFolder@view.Job.TaskName</span>
                            @if (_importsByJob.TryGetValue(view.Job.Id, out var imported))
                            {
                                <span class="badge-skill" title="Imported from package @imported.PackageId">imported</span>
                            }
                        </div>
                    </td>
                    <td>@(view.Job.Cadence ?? "—")</td>
                    <td>@RenderHealth(view.Job.Id, view.Status)</td>
                    <td>@FormatTime(view.Status?.LastRunTime)</td>
                    <td>@FormatTime(view.Status?.NextRunTime)</td>
                    <td class="cwd">@(view.Job.Cwd ?? "—")</td>
                    <td>
                        @if (view.Job.Skills.Count == 0)
                        {
                            <span>—</span>
                        }
                        else
                        {
                            @foreach (var skill in view.Job.Skills)
                            {
                                <span class="badge-skill" title="@skill.Resolution">@skill.Skill</span>
                            }
                        }
                    </td>
                    <td class="schedule-actions">
                        <button class="btn-refresh" onclick="narniaScheduleEdit('@view.Job.Id')" title="Edit">✏️ Edit</button>
                        <button class="launch-btn" onclick="narniaScheduleRun('@view.Job.Id')" title="Run now">▶</button>
                        <button class="btn-refresh" onclick="narniaScheduleEnable('@view.Job.Id', false)" title="Disable">⏸</button>
                        <button class="btn-refresh" onclick="narniaScheduleEnable('@view.Job.Id', true)" title="Enable">⏵</button>
                        <button class="btn-refresh" data-job-name="@view.Job.Name" onclick="narniaScheduleViewLog('@view.Job.Id', this)" title="View latest run log">📄 Log</button>
                        <button class="btn-bulk-archive" onclick="narniaScheduleDelete('@view.Job.Id')" title="Delete">🗑</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="sched-package-panel">
    <h2>Move or share scheduled work</h2>
    <p class="settings-hint">
        Import a <code>.narnia-schedules.json</code> package. Narnia previews path mappings,
        dependencies, timezone differences, and task-name conflicts before creating anything.
        Imported jobs are always registered disabled.
    </p>
    <div class="sched-package-file-row">
        <input id="sched-package-file" type="file" accept=".json,.narnia-schedules.json,application/json" />
        <button class="btn-refresh" onclick="narniaSchedulePreviewSelectedPackage()">Preview package</button>
        <button class="btn-refresh" id="sched-package-refresh" style="display:none;" onclick="narniaScheduleRefreshPackagePreview()">Refresh preview</button>
        <button class="launch-btn" id="sched-package-import" style="display:none;" disabled onclick="narniaScheduleImportPackage()">Import disabled</button>
    </div>
    <p id="sched-package-status" class="settings-hint"></p>
    <div id="sched-package-bindings"></div>
    <div id="sched-package-jobs"></div>
</div>

<div class="sched-create">
    <button type="button" class="sched-toggle-btn" id="sched-form-title" onclick="narniaToggleScheduleForm()">➕ New scheduled job</button>
    <div class="sched-form" id="sched-form-panel" style="display:none;">
        <input type="hidden" id="sched-edit-id" value="" />
        <label>Name <input id="sched-name" type="text" /></label>
        <label>Description <input id="sched-desc" type="text" /></label>
        <label class="sched-wide">Prompt (what Copilot runs)
            <textarea id="sched-prompt" rows="3" placeholder="Run example-issue-radar with --lookback 24h"></textarea>
        </label>
        <label>Working dir <input id="sched-cwd" type="text" placeholder="(optional)" /></label>
        <label>Copilot args <input id="sched-copilotargs" type="text" placeholder="(optional, e.g. --model ...)" /></label>
        <label>Allow flags <input id="sched-flags" type="text" value="--allow-all-tools --allow-all-paths" /></label>
        <label>Cadence
            <select id="sched-cadence" onchange="narniaCadenceChanged()"><option value="daily">Daily</option><option value="weekly">Weekly</option><option value="monthly">Monthly</option></select>
        </label>
        <label>Time <input id="sched-time" type="text" value="05:00" /></label>
        <div class="sched-days" id="sched-days-row">
            @foreach (var d in new[] { "Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday" })
            {
                <label><input type="checkbox" class="sched-day" value="@d" /> @d[..3]</label>
            }
        </div>
        <label id="sched-dom-row" style="display:none;">Day of month <input id="sched-dom" type="number" min="1" max="31" value="1" /></label>
        <div class="sched-wide sched-skills-field">
            <label>Skills (metadata)</label>
            <div id="sched-skills-list" class="sched-skills-list"></div>
            <button type="button" class="btn-refresh" onclick="narniaAddSkillRow()">+ Add skill</button>
        </div>
        <div class="sched-buttons">
            <button class="launch-btn" onclick="narniaScheduleSubmit(true)">Save & register</button>
            <button class="btn-refresh" onclick="narniaScheduleSubmit(false)">Show script + command</button>
            <button class="btn-refresh" onclick="narniaScheduleResetForm()">Clear</button>
        </div>
        <div id="sched-copyout" class="sched-wide" style="display:none;">
            <label>Generated wrapper script <textarea id="sched-script-box" class="sched-command" readonly></textarea></label>
            <label>Registration command <textarea id="sched-command" class="sched-command" readonly></textarea></label>
        </div>
    </div>
</div>

@if (_untracked.Count > 0)
{
    <h2>Orphaned tasks in <code>\Narnia\</code> <span class="window-meta">@_untracked.Count task@(_untracked.Count == 1 ? "" : "s")</span></h2>
    <p class="settings-hint">
        These scheduled tasks are in the Narnia folder but have no matching job — likely left over
        from an older version. You can remove them from Task Scheduler directly.
    </p>
    <table class="schedule-table" data-resizable-table="orphaned-scheduled-tasks">
        <thead>
            <tr>
                <th>Task</th>
                <th>State</th>
                <th>Health</th>
                <th>Last run</th>
                <th>Next run</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var task in _untracked)
            {
                <tr>
                    <td class="schedule-task">@task.TaskFolder@task.TaskName</td>
                    <td>@task.State.ToString().ToLowerInvariant()</td>
                    <td>@RenderHealth(null, task)</td>
                    <td>@FormatTime(task.LastRunTime)</td>
                    <td>@FormatTime(task.NextRunTime)</td>
                    <td class="cwd">@(task.ActionSummary ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<ScheduledJobStatusView> _jobs = [];
    private IReadOnlyList<ScheduledTaskStatus> _untracked = [];
    private IReadOnlyDictionary<string, ScheduledJobImportRecord> _importsByJob =
        new Dictionary<string, ScheduledJobImportRecord>(StringComparer.Ordinal);
    private bool _schedulerSupported;

    protected override async Task OnInitializedAsync()
    {
        var view = await JobService.ListAsync();
        _schedulerSupported = view.SchedulerSupported;
        _jobs = view.Jobs;
        _untracked = view.Untracked;
        _importsByJob = (await ImportRepository.GetByJobIdsAsync(
                _jobs.Select(job => job.Job.Id).ToArray(),
                CancellationToken.None))
            .ToDictionary(record => record.JobId, StringComparer.Ordinal);
    }

    private static string FormatTime(DateTimeOffset? time) =>
        time?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—";

    private RenderFragment RenderHealth(string? jobId, ScheduledTaskStatus? status) => __builder =>
    {
        var health = status.GetHealthKind();
        if (health == ScheduledTaskHealthKind.Drift)
        {
            <span class="badge-health badge-drift" title="No matching scheduled task found">drift</span>
            return;
        }

        if (health == ScheduledTaskHealthKind.Running)
        {
            <button type="button" class="badge-health badge-running badge-fail-link" onclick="narniaScheduleViewLog('@jobId', null)" title="Click to watch its log">● running</button>
            return;
        }

        var (cssClass, label) = HealthPresentation(health, status?.LastResult);
        if (jobId is not null && health == ScheduledTaskHealthKind.Failed)
        {
            <button type="button" class="badge-health @cssClass badge-fail-link" onclick="narniaScheduleViewLog('@jobId', null)" title="Click to see why it failed">@label</button>
        }
        else
        {
            <span class="badge-health @cssClass">@label</span>
        }
    };

    private static (string CssClass, string Label) HealthPresentation(
        ScheduledTaskHealthKind health,
        int? lastResult) => health switch
    {
        ScheduledTaskHealthKind.NeverRun => ("badge-neutral", "never run"),
        ScheduledTaskHealthKind.Succeeded => ("badge-ok", "ok"),
        ScheduledTaskHealthKind.Disabled => ("badge-neutral", "disabled"),
        ScheduledTaskHealthKind.NoMoreRunsScheduled => ("badge-neutral", "no more runs scheduled"),
        ScheduledTaskHealthKind.NotFullyScheduled => ("badge-neutral", "not fully scheduled"),
        ScheduledTaskHealthKind.Terminated => ("badge-neutral", "terminated"),
        ScheduledTaskHealthKind.NoValidTriggers => ("badge-neutral", "no valid triggers"),
        ScheduledTaskHealthKind.EventTrigger => ("badge-neutral", "event trigger"),
        ScheduledTaskHealthKind.Failed => ("badge-fail", $"failed (0x{lastResult!.Value:X})"),
        _ => ("badge-neutral", health.ToString().ToLowerInvariant()),
    };
}

@page "/"
@using NexusLabs.Narnia.Core.Models
@using NexusLabs.Narnia.Core.Repositories
@inject ISessionRepository Repository

<PageTitle>Narnia — Copilot Session Browser</PageTitle>

<div class="home-hero">
    <h1>🗡️ Narnia</h1>
    <p class="home-tagline">Browse, search, and resume your GitHub Copilot CLI sessions — even after a restart.</p>
    <p class="home-description">
        Narnia reads your local <code>~/.copilot/session-store.db</code> and session-state files so you can
        quickly find past work, review conversation history and checkpoints, and pick up where you left off.
        Use the <a href="/sessions">Sessions</a> page to search across all sessions, or jump straight to a recent one below.
    </p>
</div>

<div class="page-actions">
    <h2>Recent Sessions</h2>
    <a href="/" class="btn-refresh">↻ Refresh</a>
</div>

@if (_sessions is null)
{
    <p>Loading...</p>
}
else if (_sessions.Length == 0)
{
    <p>No sessions found. Make sure <code>~/.copilot/session-store.db</code> exists.</p>
}
else
{
    <table class="sessions-table">
        <thead>
            <tr>
                <th class="col-favorite">Favorite</th>
                <th>Summary</th>
                <th>Remote Repository</th>
                <th>Working Directory</th>
                <th>Turns</th>
                <th>Checkpoints</th>
                <th>Updated</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in _sessions)
            {
                <tr>
                    <td class="col-favorite"><FavoriteButton SessionId="@s.Id" IsFavorite="@s.IsFavorite" /></td>
                    <td><a href="/sessions/@s.Id">@(s.Summary ?? "(no summary)")</a></td>
                    <td><SessionFilterLink FilterName="repository" Value="@s.Repository" /></td>
                    <td><SessionFilterLink FilterName="cwd" Value="@s.Cwd" CssClass="cwd" /></td>
                    <td>@s.TurnCount</td>
                    <td>@s.CheckpointCount</td>
                    <td>@s.UpdatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
    <p class="home-view-all"><a href="/sessions">View all sessions →</a> · <a href="/favorites">View favorites →</a></p>
}

@code {
    private SessionSummary[]? _sessions;

    protected override async Task OnInitializedAsync()
    {
        _sessions = await Repository.ListRecentAsync(10);
    }
}

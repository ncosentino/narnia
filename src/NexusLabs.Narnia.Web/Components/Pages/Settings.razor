@page "/settings"
@using NexusLabs.Narnia.Core.Repositories
@inject INarniaSettingsRepository SettingsRepo

<PageTitle>Settings — Narnia</PageTitle>

<h1>⚙️ Settings</h1>

<div class="settings-section">
    <h2>Appearance</h2>
    <p class="settings-hint">
        Choose the theme for the entire site. Narnia defaults to dark mode.
        Your choice is saved and applied across sessions.
    </p>

    <div class="setting-field">
        <span class="setting-label">Theme</span>
        <div class="theme-options">
            <label class="theme-option">
                <input type="radio" name="theme" value="dark"
                       checked="@(_theme == "dark")"
                       onchange="narniaSetTheme('dark')" />
                🌙 Dark
            </label>
            <label class="theme-option">
                <input type="radio" name="theme" value="light"
                       checked="@(_theme == "light")"
                       onchange="narniaSetTheme('light')" />
                ☀️ Light
            </label>
        </div>
    </div>
</div>

<div class="settings-section">
    <h2>Shell Configuration</h2>
    <p class="settings-hint">
        Configure the shell used when launching resume commands from session pages.
        The launch button opens a new terminal window in the selected directory and runs <code>copilot --resume</code>.
    </p>

    <div class="setting-field">
        <label for="setting-shell-path">Shell Path</label>
        <div class="setting-input-group">
            <input id="setting-shell-path" type="text" value="@_shellPath"
                   placeholder="pwsh.exe" />
            <button class="btn-detect" onclick="narniaDetectShell()">Auto-detect</button>
        </div>
        <span class="setting-hint">
            Full path to your preferred shell executable
            (e.g., <code>C:\Program Files\PowerShell\7\pwsh.exe</code>)
        </span>
    </div>

    <div class="setting-actions">
        <button class="btn-save" onclick="narniaSaveSettings()">Save</button>
    </div>

    @if (!string.IsNullOrEmpty(_shellPath))
    {
        <div class="setting-current">
            <strong>Current:</strong> <code>@_shellPath</code>
        </div>
    }
    else
    {
        <div class="setting-current setting-current--warn">
            <strong>No shell configured.</strong> Click <em>Auto-detect</em> to find one, or enter a path manually.
        </div>
    }
</div>

@code {
    private string _shellPath = "";
    private string _theme = "dark";

    protected override async Task OnInitializedAsync()
    {
        _shellPath = await SettingsRepo.GetAsync("shell_path") ?? "";
        _theme = await SettingsRepo.GetAsync("theme") == "light" ? "light" : "dark";
    }
}

@page "/files"
@using NexusLabs.Narnia.Core.Models
@using NexusLabs.Narnia.Core.Repositories
@using System.Text.Json
@inject ISessionRepository Repository

<PageTitle>File History — Narnia</PageTitle>

<h1>File History</h1>
<p>View every session that touched a specific file.</p>

<form method="get" action="/files">
    <input type="text" name="path" value="@Path" placeholder="Enter file path, e.g. src/Program.cs" style="font-family:monospace" />
    <button type="submit">Look up</button>
</form>

@if (!string.IsNullOrWhiteSpace(Path) && _history is null)
{
    <p>Loading…</p>
}
else if (_history is { Length: 0 })
{
    <p>No sessions found for <code>@Path</code>.</p>
}
else if (_history is not null)
{
    <p><strong>@_history.Length session(s)</strong> touched <code>@Path</code></p>

    <div class="chart-container">
        <canvas id="file-history-chart"></canvas>
    </div>
    <script type="application/json" data-chart-id="file-history-chart">
        @((MarkupString)BuildChartJson(_history))
    </script>

    <div class="file-timeline">
        @foreach (var entry in _history)
        {
            <div class="file-timeline-entry">
                <div class="file-timeline-date">@entry.FirstSeenAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</div>
                <div>
                    <a class="file-timeline-summary" href="/sessions/@entry.SessionId">@(entry.Summary ?? entry.SessionId)</a>
                    @if (entry.ToolName is not null)
                    {
                        <span class="file-timeline-tool">@entry.ToolName</span>
                    }
                </div>
                @if (entry.CheckpointOverview is not null)
                {
                    <div class="file-timeline-overview">@entry.CheckpointOverview</div>
                }
            </div>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "path")]
    public string? Path { get; set; }

    private FileHistoryEntry[]? _history;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Path))
            _history = await Repository.GetFileHistoryAsync(Path);
    }

    private static string BuildChartJson(FileHistoryEntry[] data)
    {
        var byMonth = data
            .GroupBy(e => e.FirstSeenAt.ToString("yyyy-MM"))
            .OrderBy(g => g.Key)
            .ToArray();

        return JsonSerializer.Serialize(new
        {
            type = "bar",
            data = new
            {
                labels = byMonth.Select(g => g.Key).ToArray(),
                datasets = new[]
                {
                    new { label = "Sessions", data = byMonth.Select(g => g.Count()).ToArray(),
                          backgroundColor = "rgba(239,68,68,0.7)", borderColor = "rgba(239,68,68,1)", borderWidth = 1 }
                }
            },
            options = new
            {
                responsive = true,
                plugins = new { legend = new { display = false } },
                scales = new { y = new { beginAtZero = true, ticks = new { stepSize = 1 } } }
            }
        });
    }
}

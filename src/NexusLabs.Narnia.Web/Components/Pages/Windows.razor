@page "/runtime/windows"
@using NexusLabs.Narnia.Core.Models
@using NexusLabs.Narnia.Core.Repositories
@using NexusLabs.Narnia.Core.Services
@inject ITerminalWindowAggregator WindowSources
@inject ISessionRepository SessionRepository
@inject ISessionOverridesRepository OverridesRepository

<PageTitle>Sessions — Narnia</PageTitle>

<div class="page-actions">
    <h1>🪟 Terminal Sessions</h1>
    <a href="/runtime/windows" class="btn-refresh">↻ Refresh</a>
</div>

<nav class="section-nav" aria-label="Runtime views">
    <SectionNavLink Href="/runtime/windows" Icon="🪟" Label="Windows" Active="true" />
    <SectionNavLink Href="/runtime/processes" Icon="🖥️" Label="Processes" />
</nav>

<p class="settings-hint">
    Narnia records each Copilot session you launch in Windows Terminal, so you can reopen one after
    its window is closed or lost — like restoring a browser tab. Recording happens automatically in
    the background; reopening is always manual.
    <span id="windows-live-indicator" class="windows-live">● live — auto-refreshes when a session opens or closes</span>
</p>

<div id="windows-root" data-signature="@Signature()">
@if (_open.Count == 0 && _closed.Count == 0)
{
    <p>
        No Copilot sessions recorded yet. Launch sessions from the <a href="/sessions">Sessions</a>
        page and they will appear here within a minute.
    </p>
}

@if (_open.Count > 0)
{
    <div class="page-actions">
        <h2>Open now <span class="window-meta">@_open.Count session@(_open.Count == 1 ? "" : "s")</span></h2>
        <div class="closed-controls">
            <label class="closed-control"><input type="checkbox" id="open-check-all" onchange="narniaToggleAllOpen(this)" /> Select all</label>
            <button class="btn-bulk-collection"
                    id="btn-add-open-to-collection"
                    onclick="narniaAddOpenToCollection(this)"
                    disabled>
                🗂️ Add selected to Collection (0)
            </button>
        </div>
    </div>
    <div class="window-card">
        <ul class="window-tabs">
            @foreach (var record in _open)
            {
                @RenderSessionRow(record, isClosed: false)
            }
        </ul>
    </div>
}

@if (_closed.Count > 0)
{
    <div class="page-actions">
        <h2>Recently closed <span class="window-meta">@_closed.Count session@(_closed.Count == 1 ? "" : "s")</span></h2>
        <div class="closed-controls">
            <label class="closed-control"><input type="checkbox" id="closed-check-all" onchange="narniaToggleAllClosed(this)" /> Select all</label>
            <label class="closed-control" title="Off: each session opens in its own window. On: all selected sessions open as tabs in one window."><input type="checkbox" id="closed-one-window" /> Open as tabs in one window</label>
            <button class="launch-btn" id="btn-reopen-selected" onclick="narniaReopenSelected(this)" disabled>🚀 Reopen selected (0)</button>
        </div>
    </div>
    <div class="window-card">
        <ul class="window-tabs">
            @foreach (var record in _closed)
            {
                @RenderSessionRow(record, isClosed: true)
            }
        </ul>
    </div>
}
</div>

@code {
    private IReadOnlyList<TerminalWindow> _open = [];
    private IReadOnlyList<TerminalWindow> _closed = [];
    private readonly Dictionary<string, Session> _sessions = new(StringComparer.Ordinal);
    private IReadOnlyDictionary<string, SessionOverride> _overrides =
        new Dictionary<string, SessionOverride>(StringComparer.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        var snapshot = await WindowSources.GetWindowsAsync(50);
        _open = snapshot.Open;
        _closed = snapshot.Closed;
        _overrides = await OverridesRepository.GetAllOverridesAsync();

        var sessionIds = _open.Concat(_closed)
            .SelectMany(w => w.Tabs)
            .Select(t => t.SessionId)
            .Distinct(StringComparer.Ordinal);

        foreach (var sessionId in sessionIds)
        {
            var session = await SessionRepository.GetByIdAsync(sessionId);
            if (session is not null)
                _sessions[sessionId] = session;
        }
    }

    private RenderFragment RenderSessionRow(TerminalWindow record, bool isClosed) => __builder =>
    {
        var tab = record.Tabs.OrderBy(t => t.TabOrder).FirstOrDefault();
        var sessionId = tab?.SessionId;
        var session = sessionId is not null ? Lookup(sessionId) : null;
        var selectable = isClosed || sessionId is not null;
        <li class="window-tab @(selectable ? "window-tab--actionable" : "")">
            @if (isClosed)
            {
                <input type="checkbox" class="closed-check" value="@record.Id" onchange="narniaClosedSelectionChanged()" aria-label="Select session" />
            }
            else if (sessionId is not null)
            {
                <input type="checkbox" class="open-check" value="@sessionId" onchange="narniaOpenSelectionChanged()" aria-label="Select session" />
            }
            <a class="window-tab-summary" href="/sessions/@sessionId">@(session?.Summary ?? Short(sessionId))</a>
            <span class="window-tab-repo">@(session?.Repository ?? "—")</span>
            <span class="window-tab-dir cwd">@(tab?.Directory ?? session?.Cwd ?? "—")</span>
            @if (isClosed || sessionId is not null)
            {
                <span class="window-tab-actions">
                    @if (sessionId is not null)
                    {
                        <FavoriteButton SessionId="@sessionId" IsFavorite="@IsFavorite(sessionId, session)" />
                    }
                    @if (!isClosed)
                    {
                        <a class="btn-refresh" href="/runtime/processes?q=@record.TerminalProcessId"
                           title="Inspect this Windows Terminal process and its child processes">
                            PID @record.TerminalProcessId
                        </a>
                    }
                    @if (isClosed)
                    {
                        <button class="launch-btn" onclick="narniaReopenWindow('@record.Id', this)" title="Reopen this session in a new terminal window">🚀 Reopen</button>
                        <button class="btn-bulk-archive" onclick="narniaDeleteWindow('@record.Id')" title="Delete this record">🗑</button>
                    }
                </span>
            }
        </li>
    };

    private Session? Lookup(string sessionId) =>
        _sessions.TryGetValue(sessionId, out var session) ? session : null;

    private bool IsFavorite(string sessionId, Session? session) =>
        session?.IsFavorite
        ?? (_overrides.TryGetValue(sessionId, out var sessionOverride) && sessionOverride.IsFavorite);

    private string Signature()
    {
        var tokens = _open.Concat(_closed)
            .OrderBy(w => w.Id, StringComparer.Ordinal)
            .Select(w => string.Join(":",
                w.Id,
                w.Status == TerminalWindowStatus.Open ? "open" : "closed",
                w.Tabs.Count.ToString(),
                w.Pinned ? "1" : "0",
                w.OccurrenceCount.ToString(),
                w.Name ?? "",
                string.Join(",", w.Tabs
                    .OrderBy(tab => tab.TabOrder)
                    .Select(tab => $"{tab.SessionId}:{(IsFavorite(tab.SessionId, Lookup(tab.SessionId)) ? "1" : "0")}"))));
        return string.Join("|", tokens);
    }

    private static string Short(string? sessionId) =>
        sessionId is null ? "(unknown session)" : (sessionId.Length >= 8 ? sessionId[..8] : sessionId);
}

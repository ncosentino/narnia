@if (string.IsNullOrWhiteSpace(Value))
{
    <span class="@CssClass">—</span>
}
else
{
    <a class="@CssClass" href="@ResolvedHref">@Value</a>
}

@code {
    /// <summary>
    /// Gets or sets the exact Sessions-page query parameter to populate.
    /// </summary>
    [Parameter, EditorRequired]
    public string FilterName { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets the metadata value displayed by the link.
    /// </summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>
    /// Gets or sets an optional CSS class applied to the rendered value.
    /// </summary>
    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>
    /// Gets or sets an optional caller-provided URL that preserves the current page scope.
    /// </summary>
    [Parameter]
    public string? Href { get; set; }

    private string ResolvedHref =>
        Href ?? $"/sessions?{FilterName}={Uri.EscapeDataString(Value!)}";

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (FilterName is not ("repository" or "cwd"))
            throw new InvalidOperationException($"Unsupported session filter '{FilterName}'.");
    }
}

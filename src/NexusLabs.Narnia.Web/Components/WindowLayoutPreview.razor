@using System.Globalization
@using NexusLabs.Narnia.Core.Models

<div class="layout-preview"
     role="img"
     aria-label="@AriaLabel">
    <div class="layout-preview-stage" style="@StageStyle">
        @foreach (var monitor in _monitors)
        {
            <div class="layout-preview-monitor" style="@RectangleStyle(monitor.WorkArea, 1)">
                <span>@MonitorLabel(monitor)</span>
            </div>
        }

        @foreach (var slot in Value.Slots.OrderByDescending(slot => slot.ZOrder))
        {
            var collectionName = CollectionName(slot.CollectionId);
            <div class="layout-preview-window layout-preview-window--@(slot.SlotOrder % 6)"
                 style="@RectangleStyle(slot.CapturedBounds, 10 + Value.Slots.Count - slot.ZOrder)"
                 title="@WindowTooltip(slot, collectionName)">
                <strong>@collectionName</strong>
                @if (!string.IsNullOrWhiteSpace(slot.CapturedWindowTitle) &&
                    !string.Equals(
                        slot.CapturedWindowTitle,
                        collectionName,
                        StringComparison.OrdinalIgnoreCase))
                {
                    <span>@slot.CapturedWindowTitle</span>
                }
            </div>
        }
    </div>

    <div class="layout-preview-legend">
        @foreach (var slot in Value.Slots.OrderBy(slot => slot.SlotOrder))
        {
            <span>
                <i class="layout-preview-swatch layout-preview-window--@(slot.SlotOrder % 6)"></i>
                @CollectionName(slot.CollectionId)
            </span>
        }
    </div>
</div>

@code {
    /// <summary>Gets or sets the persisted Layout to visualize.</summary>
    [Parameter, EditorRequired]
    public WindowLayout Value { get; set; } = null!;

    /// <summary>Gets or sets Collections available for resolving slot labels.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyDictionary<string, WorkCollection> Collections { get; set; } =
        new Dictionary<string, WorkCollection>(StringComparer.Ordinal);

    private IReadOnlyList<PreviewMonitor> _monitors = [];
    private int _minimumX;
    private int _minimumY;
    private int _desktopWidth = 1;
    private int _desktopHeight = 1;

    private string AriaLabel =>
        $"{Value.Name}: {Value.Slots.Count} Collection window" +
        (Value.Slots.Count == 1 ? "" : "s") +
        $" across {_monitors.Count} monitor" +
        (_monitors.Count == 1 ? "" : "s");

    private string StageStyle =>
        $"aspect-ratio: {_desktopWidth.ToString(CultureInfo.InvariantCulture)} / " +
        $"{_desktopHeight.ToString(CultureInfo.InvariantCulture)};";

    protected override void OnParametersSet()
    {
        _monitors = Value.Slots
            .GroupBy(slot => slot.MonitorDeviceName, StringComparer.OrdinalIgnoreCase)
            .Select(group =>
            {
                var representative = group.First();
                return new PreviewMonitor(
                    representative.MonitorDeviceName,
                    representative.MonitorIsPrimary,
                    representative.CapturedWorkArea);
            })
            .OrderBy(monitor => monitor.WorkArea.X)
            .ThenBy(monitor => monitor.WorkArea.Y)
            .ToArray();

        if (_monitors.Count == 0)
        {
            _minimumX = 0;
            _minimumY = 0;
            _desktopWidth = 1;
            _desktopHeight = 1;
            return;
        }

        _minimumX = _monitors.Min(monitor => monitor.WorkArea.X);
        _minimumY = _monitors.Min(monitor => monitor.WorkArea.Y);
        var maximumX = _monitors.Max(
            monitor => monitor.WorkArea.X + monitor.WorkArea.Width);
        var maximumY = _monitors.Max(
            monitor => monitor.WorkArea.Y + monitor.WorkArea.Height);
        _desktopWidth = Math.Max(1, maximumX - _minimumX);
        _desktopHeight = Math.Max(1, maximumY - _minimumY);
    }

    private string RectangleStyle(WindowRectangle rectangle, int zIndex) =>
        string.Join(
            " ",
            $"left: {Percent(rectangle.X - _minimumX, _desktopWidth)};",
            $"top: {Percent(rectangle.Y - _minimumY, _desktopHeight)};",
            $"width: {Percent(rectangle.Width, _desktopWidth)};",
            $"height: {Percent(rectangle.Height, _desktopHeight)};",
            $"z-index: {zIndex};");

    private string CollectionName(string id) =>
        Collections.TryGetValue(id, out var collection)
            ? collection.Name
            : $"Missing {Short(id)}";

    private static string MonitorLabel(PreviewMonitor monitor) =>
        monitor.IsPrimary
            ? $"{monitor.DeviceName} · primary"
            : monitor.DeviceName;

    private static string WindowTooltip(
        WindowLayoutSlot slot,
        string collectionName) =>
        $"{collectionName} — {slot.CapturedBounds.Width}×{slot.CapturedBounds.Height} " +
        $"at {slot.CapturedBounds.X},{slot.CapturedBounds.Y}";

    private static string Percent(int value, int total) =>
        (value * 100d / total).ToString("0.###", CultureInfo.InvariantCulture) + "%";

    private static string Short(string id) =>
        id.Length > 8 ? id[..8] : id;

    private sealed record PreviewMonitor(
        string DeviceName,
        bool IsPrimary,
        WindowRectangle WorkArea);
}

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Blazor SSR does not yet support NativeAOT or full trimming (as of .NET 10).
         The MCP server uses NativeAOT; the Web app uses standard JIT publish. -->
    <CopilotSkipCliDownload>true</CopilotSkipCliDownload>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GitHub.Copilot.SDK" ExcludeAssets="native" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="System.Management" />
    <ProjectReference Include="..\NexusLabs.Narnia.Core\NexusLabs.Narnia.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Publish the canonical documentation artwork as runtime static assets without
         committing a second copy of either binary. -->
    <Content Include="..\..\docs\assets\favicon.png;..\..\docs\assets\narnia-logo.png">
      <Link>wwwroot\%(Filename)%(Extension)</Link>
      <TargetPath>wwwroot\%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Lets Web.Tests directly unit-test internal MCP tool classes (e.g. ScheduleTools) with
         mocked services, instead of only exercising them through a full MCP protocol round-trip. -->
    <InternalsVisibleTo Include="NexusLabs.Narnia.Web.Tests" />
  </ItemGroup>

</Project>

# Copy this file to:
#   Windows: %LOCALAPPDATA%\narnia\report-email\default.env
#   Other platforms: <LocalApplicationData>/narnia/report-email/default.env
#
# Process environment variables with the same names override file values.

NARNIA_REPORT_EMAIL_SMTP_HOST=smtp.example.com
NARNIA_REPORT_EMAIL_SMTP_PORT=587
NARNIA_REPORT_EMAIL_SMTP_USERNAME=reports@example.com
NARNIA_REPORT_EMAIL_SMTP_PASSWORD='replace-with-an-app-password'
NARNIA_REPORT_EMAIL_FROM='Narnia Reports <reports@example.com>'
NARNIA_REPORT_EMAIL_TO=recipient@example.com
NARNIA_REPORT_EMAIL_ENABLE_SSL=true
NARNIA_REPORT_EMAIL_TIMEOUT_SECONDS=30
